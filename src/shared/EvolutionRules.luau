-- Pure evolution rules for Catch a Cloud. Server-authoritative; never trust client.\nlocal Rules = {}\n\n-- Evolution paths: base species evolves into evolved form after threshold catches of the base.\n-- Thresholds are modest for progression; no paid shortcuts.\nlocal PATHS = {\n    breeze = { into = \"gale\", threshold = 15 },\n    drizzle = { into = \"monsoon\", threshold = 12 },\n    ember = { into = \"inferno\", threshold = 10 },\n    frost = { into = \"glacier\", threshold = 10 },\n    spring = { into = \"bloom\", threshold = 12 },\n    pebble = { into = \"geode\", threshold = 14 },\n}\n\nfunction Rules.canEvolve(speciesId, count, catalog)\n    local path = PATHS[speciesId]\n    if not path or type(count) ~= \"number\" or count ~= count or count < path.threshold then\n        return false\n    end\n    return catalog[path.into] ~= nil\nend\n\nfunction Rules.evolve(speciesId, speciesCounts, catalog)\n    if not Rules.canEvolve(speciesId, speciesCounts[speciesId], catalog) then\n        return speciesCounts, false\n    end\n    local path = PATHS[speciesId]\n    local next = {}\n    for k, v in pairs(speciesCounts) do\n        next[k] = v\n    end\n    next[speciesId] = math.max(0, (next[speciesId] or 0) - 1)\n    next[path.into] = (next[path.into] or 0) + 1\n    return next, true\nend\n\nfunction Rules.paths()\n    return PATHS\nend\n\nreturn Rules\n