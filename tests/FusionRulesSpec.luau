return function(test, eq)
    local Fusion = require("../src/shared/FusionRules")
    local catalog = { breeze = { element = "Air" }, drizzle = { element = "Water" } }
    local function profile(count, coins, bond)
        return { species = { breeze = count }, coins = coins, companionBond = { breeze = bond or 0 } }
    end
    test("fusion consumes two spares and coins while keeping one cloud", function()
        local old = profile(3, 100)
        local result = Fusion.apply(old, "breeze", catalog)
        eq(result.ok, true, "success")
        eq(result.data.species.breeze, 1, "last specimen preserved")
        eq(result.data.coins, 25, "coins charged")
        eq(result.data.companionBond.breeze, 15, "bond gained")
        eq(old.species.breeze, 3, "original count untouched")
        eq(old.coins, 100, "original coins untouched")
    end)
    test("fusion refuses to consume final specimen or insufficient coins", function()
        eq(Fusion.apply(profile(2, 100), "breeze", catalog).reason, "need_spares", "copies")
        eq(Fusion.apply(profile(3, 74), "breeze", catalog).reason, "need_coins", "coins")
    end)
    test("fusion rejects unknown IDs and malformed numeric state", function()
        eq(Fusion.apply(profile(3, 100), "fake", catalog).reason, "invalid_species", "unknown")
        eq(Fusion.apply(profile(3, 100), "bad:id", catalog).reason, "invalid_species", "invalid id")
        eq(Fusion.apply(profile(3.5, 100), "breeze", catalog).reason, "need_spares", "fraction")
        eq(Fusion.apply(profile(3, 0/0), "breeze", catalog).reason, "need_coins", "nan")
        eq(Fusion.apply(profile(3, 100, math.huge), "breeze", catalog).reason, "invalid_bond", "inf")
    end)
    test("fusion caps bond and refuses maxed bonds", function()
        local result = Fusion.apply(profile(4, 200, 999995), "breeze", catalog)
        eq(result.ok, true, "near cap")
        eq(result.bondGain, 5, "capped gain")
        eq(result.data.companionBond.breeze, 1000000, "bond capped")
        eq(Fusion.apply(profile(4, 200, 1000000), "breeze", catalog).reason, "bond_maxed", "max")
    end)
end
