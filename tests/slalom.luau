local Rules = require("../src/shared/SlalomRules")
local function eq(a,b) assert(a == b, tostring(a) .. " != " .. tostring(b)) end
local s,status = Rules.advance(nil,1,4,100)
eq(status,"started")
s,status = Rules.advance(s,2,5,115)
eq(status,"checkpoint")
s,status = Rules.advance(s,3,5,120)
eq(status,"checkpoint")
s,status = Rules.advance(s,4,6,130)
eq(status,"finished")
eq(s.finished,30)
eq(select(2, Rules.advance(nil,4,4,100)),"out_of_order_or_expired")
eq(select(2, Rules.advance({started=100,nextGate=2},3,4,110)),"out_of_order_or_expired")
eq(select(2, Rules.advance({started=100,nextGate=2},2,4,196)),"out_of_order_or_expired")
eq(select(2, Rules.advance(nil,1,math.huge,100)),"invalid")
eq(select(2, Rules.advance(nil,1,4,0/0)),"invalid")
eq(select(2, Rules.advance(nil,1,4,100.5)),"started")
print("Sky slalom rule regression checks passed")
