return function(test, eq)
    local Rules = require("../src/shared/ObservatoryRules")
    test("observatory rewards and progression are server-gated", function()
        eq(Rules.canObserve("meadow", 0, 5, 10, 0, true), true, "starter available")
        eq(Rules.canObserve("eastwind", 11, 5, 10, 0, true), false, "locked catches")
        eq(Rules.canObserve("eastwind", 12, 5, 10, 0, true), true, "unlocked")
        eq(Rules.canObserve("ridge", 35, 5, 100, 101, true), false, "cooldown")
        eq(Rules.canObserve("ridge", 35, 5, 101, 101, true), true, "cooldown ended")
        eq(Rules.canObserve("meadow", 0, 14, 10, 0, true), false, "distance")
        eq(Rules.canObserve("meadow", 0, 5, 10, 0, false), false, "profile not ready")
        eq(Rules.canObserve("bogus", 100, 5, 10, 0, true), false, "unknown")
        eq(Rules.canObserve("meadow", 0, math.huge, 10, 0, true), false, "infinite distance")
        eq(Rules.canObserve("meadow", 0, 5, 0/0, 0, true), false, "nan time")
        eq(Rules.reward("ridge"), 60, "ridge coins")
        eq(Rules.reward("bogus"), nil, "unknown no reward")
    end)
    test("observatory payout and cooldown are a single bounded state transition", function()
        local data = { captures = 35, coins = 100, xp = 50, observatoryCooldowns = {} }
        local ok, coins, xp = Rules.applyReward(data, "ridge", 1000)
        eq(ok, true, "reward granted")
        eq(coins, 60, "coins returned")
        eq(xp, 45, "xp returned")
        eq(data.coins, 160, "coins applied")
        eq(data.xp, 95, "xp applied")
        eq(data.observatoryCooldowns.ridge, 1180, "receipt applied")
        eq(Rules.applyReward(data, "ridge", 1000), false, "duplicate refused")
        eq(data.coins, 160, "duplicate does not alter coins")
        eq(Rules.applyReward(data, "ridge", 1180), true, "cooldown elapsed")
        local bad = { captures = 35, coins = 1000000000, xp = 5, observatoryCooldowns = {} }
        eq(Rules.applyReward(bad, "ridge", 1000), false, "overflow refused")
        eq(bad.observatoryCooldowns.ridge, nil, "no partial receipt")
        eq(Rules.applyReward({captures=35, coins=0/0, xp=5, observatoryCooldowns={}}, "ridge", 1000), false, "nan refused")
    end)
end
