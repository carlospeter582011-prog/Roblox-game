-- First-discovery research grant: paid only once per species, including across save/rejoin.
local Rules = require("../src/shared/CatchRules")
return function(test, eq)
    test("first discovery grants rarity-scaled research reward exactly once", function()
        local data = { species = {}, captures = 0, coins = 0, xp = 0, quests = {} }
        Rules.applyCatch(data, "aurora", 20, {}, { rarity = "Rare", xp = 10 })
        eq(data.coins, 65, "first catch + research coins")
        eq(data.xp, 30, "first catch + research xp")
        Rules.applyCatch(data, "aurora", 20, {}, { rarity = "Rare", xp = 10 })
        eq(data.coins, 85, "repeat catch only")
        eq(data.xp, 40, "repeat xp only")
    end)
    test("mutation variants do not repeat species research rewards", function()
        local data = { species = {}, captures = 0, coins = 0, xp = 0, quests = {} }
        Rules.applyCatch(data, "breeze", 10, {}, { rarity = "Common", variantId = "breeze:golden" })
        eq(data.coins, 20, "first discovery coins")
        Rules.applyCatch(data, "breeze", 10, {}, { rarity = "Common", variantId = "breeze:rainbow" })
        eq(data.coins, 30, "different mutation not another grant")
        eq(data.species["breeze:golden"], 1, "golden variant tracked")
        eq(data.species["breeze:rainbow"], 1, "rainbow variant tracked")
    end)
    test("unknown rarity or already-owned species cannot mint research rewards", function()
        local coins, xp = Rules.discoveryReward("breeze", { breeze = 3 }, "Secret")
        eq(coins, 0, "already owned coins")
        eq(xp, 0, "already owned xp")
        coins, xp = Rules.discoveryReward("breeze", {}, "NotARarity")
        eq(coins, 0, "unknown rarity coins")
        eq(xp, 0, "unknown rarity xp")
    end)
end
