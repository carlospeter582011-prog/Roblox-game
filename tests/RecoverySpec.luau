local Rules = require("../src/shared/RecoveryRules")
return function(test, eq)
    test("rescue below island fall threshold", function()
        eq(Rules.shouldRecover(-90, 30, 10, nil), true, "fallen")
        eq(Rules.shouldRecover(-84, 30, 10, nil), false, "above threshold")
    end)
    test("rescue avoids distant worlds and rate limits", function()
        eq(Rules.shouldRecover(-100, 500, 10, nil), false, "distant")
        eq(Rules.shouldRecover(-100, 20, 11, 10), false, "cooldown")
        eq(Rules.shouldRecover(-100, 20, 13, 10), true, "cooldown elapsed")
    end)
    test("rescue rejects invalid coordinates", function()
        eq(Rules.shouldRecover(0/0, 1, 10, nil), false, "NaN y")
        eq(Rules.shouldRecover(-100, 0/0, 10, nil), false, "NaN distance")
    end)
    test("deep void rescue works outside starter island radius", function()
        eq(Rules.shouldRecover(-501, 900, 10, nil), true, "deep void")
        eq(Rules.shouldRecover(-500, 900, 10, nil), true, "emergency threshold")
        eq(Rules.shouldRecover(-499, 900, 10, nil), false, "above emergency")
    end)
    test("rescue rejects infinities negative distance and reversed time", function()
        eq(Rules.shouldRecover(-math.huge, 20, 10, nil), false, "infinite height")
        eq(Rules.shouldRecover(-100, math.huge, 10, nil), false, "infinite distance")
        eq(Rules.shouldRecover(-100, -1, 10, nil), false, "negative distance")
        eq(Rules.shouldRecover(-100, 10, math.huge, nil), false, "infinite clock")
        eq(Rules.shouldRecover(-100, 10, 10, 11), false, "clock reversed")
    end)
    test("recovery uses current spawn and safe vertical clearance", function()
        local x, y, z = Rules.recoveryPosition(0, 2, -25, 5)
        eq(x, 0, "spawn x")
        eq(y, 7, "safe height")
        eq(z, -25, "spawn z")
        local x2, y2, z2 = Rules.recoveryPosition(40, 10, 60, 7)
        eq(x2, 40, "moved spawn x")
        eq(y2, 17, "moved spawn y")
        eq(z2, 60, "moved spawn z")
    end)
    test("recovery rejects invalid spawn positions and unsafe offsets", function()
        eq(Rules.recoveryPosition(0/0, 2, 0, 5), nil, "NaN spawn")
        eq(Rules.recoveryPosition(0, 2, math.huge, 5), nil, "infinite spawn")
        eq(Rules.recoveryPosition(0, 2, 0, -1), nil, "negative clearance")
        eq(Rules.recoveryPosition(0, 2, 0, 31), nil, "excessive clearance")
    end)
end
