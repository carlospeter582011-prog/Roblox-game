local Rules = require("../src/shared/RecoveryRules")
return function(test, eq)
    test("rescue below island fall threshold", function()
        eq(Rules.shouldRecover(-90, 30, 10, nil), true, "fallen")
        eq(Rules.shouldRecover(-84, 30, 10, nil), false, "above threshold")
    end)
    test("rescue avoids distant worlds and rate limits", function()
        eq(Rules.shouldRecover(-100, 500, 10, nil), false, "distant")
        eq(Rules.shouldRecover(-100, 20, 11, 10), false, "cooldown")
        eq(Rules.shouldRecover(-100, 20, 13, 10), true, "cooldown elapsed")
    end)
    test("rescue rejects invalid coordinates", function()
        eq(Rules.shouldRecover(0/0, 1, 10, nil), false, "NaN y")
        eq(Rules.shouldRecover(-100, 0/0, 10, nil), false, "NaN distance")
    end)
end
