local Rules = require("../src/shared/SlalomRules")
return function(test, eq)
    test("sky slalom full ordered course and personal timing", function()
        local state, status = Rules.advance(nil, 1, 4, 100)
        eq(status, "started", "start")
        state, status = Rules.advance(state, 2, 5, 115)
        eq(status, "checkpoint", "second")
        state, status = Rules.advance(state, 3, 5, 120)
        eq(status, "checkpoint", "third")
        state, status = Rules.advance(state, 4, 6, 130)
        eq(status, "finished", "finish")
        eq(state.finished, 30, "elapsed")
    end)
    test("sky slalom rejects skips and expired attempts", function()
        eq(select(2, Rules.advance(nil, 4, 4, 100)), "out_of_order_or_expired", "skip")
        eq(select(2, Rules.advance({started=100,nextGate=2}, 3, 4, 110)), "out_of_order_or_expired", "order")
        eq(select(2, Rules.advance({started=100,nextGate=2}, 2, 4, 196)), "out_of_order_or_expired", "timeout")
    end)
    test("sky slalom rejects malformed inputs and remote distances", function()
        eq(select(2, Rules.advance(nil, 1, math.huge, 100)), "invalid", "infinite distance")
        eq(select(2, Rules.advance(nil, 1, 4, 0/0)), "invalid", "nan time")
        eq(select(2, Rules.advance(nil, 1, 16, 100)), "invalid", "too far")
    end)
end
