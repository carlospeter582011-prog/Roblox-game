return function(test, eq)
    local Rules = require("../src/shared/CloudFusionRules")
    local Catalog = require("../src/shared/CloudCatalog")
    test("fusion consumes duplicates and coins without mutating input", function()
        local original = { breeze = 3, cirrus = 2, drizzle = 5 }
        local result = Rules.apply("breeze", "cirrus", original, 200, Catalog)
        eq(result.ok, true, "fused")
        eq(result.output, "cirrus", "rarer output")
        eq(result.coins, 75, "coin sink")
        eq(result.species.breeze, 2, "breeze consumed")
        eq(result.species.cirrus, 2, "cirrus net unchanged")
        eq(result.species.drizzle, 5, "unrelated preserved")
        eq(original.breeze, 3, "input immutable")
    end)
    test("fusion rejects insufficient duplicates, mismatched elements and funds", function()
        eq(Rules.apply("breeze", "cirrus", { breeze=1, cirrus=2 }, 500, Catalog).reason, "duplicates_required", "duplicates")
        eq(Rules.apply("breeze", "drizzle", { breeze=2, drizzle=2 }, 500, Catalog).reason, "element_mismatch", "element")
        eq(Rules.apply("breeze", "cirrus", { breeze=2, cirrus=2 }, 10, Catalog).reason, "insufficient_coins", "coins")
        eq(Rules.apply("breeze", "breeze", { breeze=3 }, 500, Catalog).reason, "distinct_species_required", "distinct")
    end)
    test("fusion rejects malformed values and cannot forge unknown species", function()
        eq(Rules.apply("breeze", "fake", { breeze=2, fake=2 }, 500, Catalog).reason, "unknown_species", "unknown")
        eq(Rules.apply("breeze", "cirrus", { breeze=2.5, cirrus=2 }, 500, Catalog).reason, "duplicates_required", "fraction")
        eq(Rules.apply("breeze", "cirrus", { breeze=2, cirrus=2 }, math.huge, Catalog).reason, "invalid_wallet", "infinity")
    end)
    test("fusion station chooses only affordable deterministic same-element pairs", function()
        local a, b, preview = Rules.firstAvailable({ breeze=3, cirrus=2, drizzle=2 }, 200, Catalog)
        eq(a, "breeze", "first sorted ingredient")
        eq(b, "cirrus", "second sorted ingredient")
        eq(preview.ok, true, "valid preview")
        local x = Rules.firstAvailable({ breeze=1, cirrus=2, drizzle=2 }, 200, Catalog)
        eq(x, nil, "no valid same-element duplicates")
        local y = Rules.firstAvailable({ breeze=2, cirrus=2 }, 0, Catalog)
        eq(y, nil, "cannot spend coins without funds")
    end)

end
