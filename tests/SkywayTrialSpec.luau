return function(test, eq)
    local Rules = require("../src/shared/SkywayTrialRules")
    test("skyway requires all four checkpoints in order", function()
        local state, result = Rules.advance(nil, 2, 100)
        eq(result, "wrong_order", "skip rejected")
        state, result = Rules.advance(state, 1, 101)
        eq(result, "progress", "start")
        eq(state.next, 2, "next checkpoint")
        state, result = Rules.advance(state, 2, 102)
        eq(result, "progress", "second")
        state, result = Rules.advance(state, 3, 103)
        eq(result, "progress", "third")
        state, result = Rules.advance(state, 4, 104)
        eq(result, "completed", "completed")
        eq(state.cooldownUntil, 104 + Rules.COOLDOWN, "cooldown")
    end)
    test("skyway times out and prevents cooldown bypass", function()
        local state = Rules.advance(nil, 1, 10)
        local nextState, result = Rules.advance(state, 2, 10 + Rules.TIME_LIMIT + 1)
        eq(result, "wrong_order", "expired")
        eq(nextState.next, 1, "restart")
        state = Rules.advance(nextState, 1, 70)
        state = Rules.advance(state, 2, 71)
        state = Rules.advance(state, 3, 72)
        state = Rules.advance(state, 4, 73)
        nextState, result = Rules.advance(state, 1, 74)
        eq(result, "cooldown", "repeat blocked")
        nextState, result = Rules.advance(state, 1, 73 + Rules.COOLDOWN)
        eq(result, "progress", "reopen")
    end)
    test("skyway rejects malformed checkpoint and clock", function()
        local _, result = Rules.advance(nil, 0, 100)
        eq(result, "invalid_checkpoint", "zero")
        _, result = Rules.advance(nil, 1.5, 100)
        eq(result, "invalid_checkpoint", "fraction")
        _, result = Rules.advance(nil, 1, math.huge)
        eq(result, "invalid_time", "infinite time")
    end)
end
