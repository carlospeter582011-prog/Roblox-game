return function(test, eq)
    local Rules = require("../src/shared/SkyLaunchRules")
    test("sky launch rejects remote distance, missing save, dead players and cooldown", function()
        eq(Rules.canLaunch(15, 12, true, true), true, "boundary allowed")
        eq(Rules.canLaunch(15.1, 12, true, true), false, "distance")
        eq(Rules.canLaunch(1, 11.9, true, true), false, "cooldown")
        eq(Rules.canLaunch(1, 12, false, true), false, "profile")
        eq(Rules.canLaunch(1, 12, true, false), false, "dead")
        eq(Rules.canLaunch(0/0, 12, true, true), false, "nan")
    end)
    test("sky launch direction is bounded and rejects zero distance", function()
        local x, y, z = Rules.velocity(0, 0, 100, 0)
        eq(x, Rules.SPEED, "east")
        eq(y, Rules.LIFT, "lift")
        eq(z, 0, "no sideways drift")
        eq(Rules.velocity(1, 1, 1, 1), nil, "zero displacement")
    end)
end
