return function(test, eq)
    local Rules = require("../src/shared/CollectionMilestoneRules")
    local catalog = { breeze = {}, drizzle = {}, frost = {}, mist = {}, ember = {} }
    test("collection milestones count only real catalog species, never mutation variants", function()
        eq(Rules.uniqueCount({ breeze = 2, ["breeze:golden"] = 5, bogus = 10, drizzle = 0 }, catalog), 1, "unique")
        eq(Rules.uniqueCount({ breeze = math.huge, drizzle = -1, frost = 1 }, catalog), 1, "invalid counts")
    end)
    test("collection milestones grant once on first unique species crossing", function()
        local c, x, threshold = Rules.reward(4, 5)
        eq(c, 100, "coins")
        eq(x, 50, "xp")
        eq(threshold, 5, "milestone")
        c, x = Rules.reward(5, 5)
        eq(c, 0, "no repeated coins")
        eq(x, 0, "no repeated xp")
        c, x = Rules.reward(5, 6)
        eq(c, 0, "duplicate species gives no milestone")
    end)
    test("collection milestone invalid inputs and multi-crossing are safe", function()
        local c, x = Rules.reward(4, 10)
        eq(c, 350, "two rewards")
        eq(x, 150, "two xp rewards")
        c, x = Rules.reward(10, 9)
        eq(c, 0, "regression rejected")
        c, x = Rules.reward(0, math.huge)
        eq(x, 0, "infinity rejected")
    end)
end
