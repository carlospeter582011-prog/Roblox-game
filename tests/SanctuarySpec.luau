return function(test, eq)
    local Rules = require("../src/shared/SanctuaryRules")
    local catalog = require("../src/shared/CloudCatalog")
    test("sanctuary preserves final specimen", function()
        eq(Rules.preview("breeze", {breeze=1}, catalog), nil, "last specimen")
        eq(Rules.preview("breeze", {breeze=0}, catalog), nil, "empty")
    end)
    test("sanctuary rewards valid duplicates", function()
        local coins, xp = Rules.preview("breeze", {breeze=3}, catalog)
        eq(coins, 15, "coins")
        eq(xp, 5, "xp")
    end)
    test("sanctuary rejects unknown and malformed inventory", function()
        eq(Rules.preview("unknown", {unknown=99}, catalog), nil, "unknown")
        eq(Rules.preview("breeze", {breeze=2.5}, catalog), nil, "fraction")
        eq(Rules.preview("breeze", {breeze=0/0}, catalog), nil, "nan")
    end)
end
