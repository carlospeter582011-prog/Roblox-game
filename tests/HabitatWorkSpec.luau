return function(test, eq)
    local Rules = require("../src/shared/HabitatWorkRules")
    local catalog = { breeze = { element = "Air" }, drizzle = { element = "Water" }, moss = { element = "Nature" } }
    test("habitat work requires owned matching elemental companion", function()
        eq(Rules.eligible("air", "breeze", { breeze = 1 }, catalog), true, "air match")
        eq(Rules.eligible("water", "breeze", { breeze = 1 }, catalog), false, "wrong element")
        eq(Rules.eligible("air", "breeze", { breeze = math.huge }, catalog), false, "invalid ownership")
        eq(Rules.eligible("air", "breeze", {}, catalog), false, "unowned")
        eq(Rules.eligible("bogus", "breeze", { breeze = 1 }, catalog), false, "unknown station")
    end)
    test("habitat rewards and cooldown are bounded and deterministic", function()
        local coins, xp = Rules.reward("air", "breeze", { breeze = 1 }, catalog, { breeze = 40 })
        eq(coins, 38, "earned bond bonus")
        eq(xp, 18, "air xp")
        eq(Rules.ready(100, nil, 180), true, "initial work")
        eq(Rules.ready(279, 100, 180), false, "cooldown")
        eq(Rules.ready(280, 100, 180), true, "ready again")
        eq(Rules.ready(0 / 0, nil, 180), false, "invalid clock")
    end)
end
