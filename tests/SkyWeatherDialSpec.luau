local Rules = require("../src/shared/SkyWeatherDialRules")
return function(test, eq)
    test("weather dial personalized sequence cycles correctly", function()
        local sequence = Rules.sequence(7, 0)
        eq(#sequence, 3, "length")
        eq(sequence[1], "Rain", "first")
        eq(sequence[2], "Wind", "second")
        eq(sequence[3], "Sun", "third")
        eq(Rules.sequence(0, 0), nil, "reject invalid user")
        eq(Rules.sequence(7, -1), nil, "reject invalid round")
    end)
    test("weather dial validates order, timeout and cooldown", function()
        local sequence = Rules.sequence(7, 0)
        local step, status = Rules.advance(sequence, 1, "Rain", 100, 101)
        eq(step, 2, "first progress") eq(status, "progress", "first status")
        step, status = Rules.advance(sequence, 2, "Wind", 100, 102)
        eq(step, 3, "second progress")
        step, status = Rules.advance(sequence, 3, "Sun", 100, 103)
        eq(step, 4, "completed") eq(status, "complete", "completion status")
        step, status = Rules.advance(sequence, 2, "Sun", 100, 102)
        eq(step, 1, "wrong glyph resets") eq(status, "reset", "reset status")
        step, status = Rules.advance(sequence, 1, "Rain", 100, 176)
        eq(status, "expired", "timeout")
        eq(Rules.ready(300, 301), false, "cooldown blocks")
        eq(Rules.ready(301, 301), true, "cooldown ends")
    end)
end
