local Rules = require("../src/shared/SkyWeatherDialRules")
local function eq(a,b) assert(a==b, tostring(a) .. " ~= " .. tostring(b)) end
local sequence = Rules.sequence(7, 0)
eq(#sequence, 3)
eq(sequence[1], "Rain")
eq(sequence[2], "Wind")
eq(sequence[3], "Sun")
eq(Rules.sequence(0, 0), nil)
eq(Rules.sequence(7, -1), nil)
local step, status = Rules.advance(sequence, 1, "Rain", 100, 101)
eq(step, 2) eq(status, "progress")
step, status = Rules.advance(sequence, 2, "Wind", 100, 102)
eq(step, 3) eq(status, "progress")
step, status = Rules.advance(sequence, 3, "Sun", 100, 103)
eq(step, 4) eq(status, "complete")
step, status = Rules.advance(sequence, 2, "Sun", 100, 102)
eq(step, 1) eq(status, "reset")
step, status = Rules.advance(sequence, 1, "Rain", 100, 176)
eq(status, "expired")
eq(Rules.ready(300, 301), false)
eq(Rules.ready(301, 301), true)
print("SkyWeatherDialSpec: passed")
