return function(test, eq)
    local Rules = require("../src/shared/SkySeedRules")
    test("wind seeds require live ready player within range", function()
        eq(Rules.canPickup(0, 12, true, true), true, "valid pickup")
        eq(Rules.canPickup(0, 14, true, true), false, "far away")
        eq(Rules.canPickup(0, 1, false, true), false, "profile not ready")
        eq(Rules.canPickup(0, 1, true, false), false, "dead")
        eq(Rules.canPickup(6, 1, true, true), false, "inventory capped")
        eq(Rules.canPickup(0/0, 1, true, true), false, "NaN count")
    end)
    test("wind shrine costs seeds and enforces cooldown and proximity", function()
        eq(Rules.canRedeem(3, 10, true, true, 100, 100), true, "ready")
        eq(Rules.canRedeem(2, 10, true, true, 100, 0), false, "insufficient")
        eq(Rules.canRedeem(3, 20, true, true, 100, 0), false, "remote")
        eq(Rules.canRedeem(3, 10, true, true, 99, 100), false, "cooldown")
        eq(Rules.canRedeem(math.huge, 10, true, true, 100, 0), false, "infinite")
        eq(Rules.canRedeem(3, 10, true, true, math.huge, 0), false, "invalid time")
    end)
end
