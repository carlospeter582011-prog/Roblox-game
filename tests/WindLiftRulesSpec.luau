local Rules = require("../src/shared/WindLiftRules")
assert(Rules.canLaunch(10, nil, 8, true))
assert(not Rules.canLaunch(11, 10, 8, true))
assert(Rules.canLaunch(14, 10, 8, true))
assert(not Rules.canLaunch(20, nil, 13, true))
assert(not Rules.canLaunch(20, nil, 8, false))
assert(not Rules.canLaunch(0/0, nil, 8, true))
assert(not Rules.canLaunch(20, nil, math.huge, true))
print("WindLiftRules regression tests passed")
