return function(test, eq)
    local Rules = require("../src/shared/WindLiftRules")
    test("wind lift validates alive players and physical proximity", function()
        eq(Rules.canLaunch(10, nil, 8, true), true, "valid nearby launch")
        eq(Rules.canLaunch(10, nil, 13, true), false, "distant")
        eq(Rules.canLaunch(10, nil, 8, false), false, "dead player")
    end)
    test("wind lift cooldown and malformed input cannot bypass checks", function()
        eq(Rules.canLaunch(11, 10, 8, true), false, "cooldown")
        eq(Rules.canLaunch(14, 10, 8, true), true, "cooldown expired")
        eq(Rules.canLaunch(0/0, nil, 8, true), false, "NaN time")
        eq(Rules.canLaunch(20, nil, math.huge, true), false, "infinite distance")
    end)
end
