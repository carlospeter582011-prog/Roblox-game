return function(test, eq)
    local Rules = require("../src/shared/WindRuneRules")
    test("wind runes require ordered sequence and enforce cooldown", function()
        local s, result = Rules.step(nil, "air", 100, 6, true, true)
        eq(result, "progress", "first")
        s, result = Rules.step(s, "rain", 101, 6, true, true)
        eq(result, "progress", "second")
        s, result = Rules.step(s, "storm", 102, 6, true, true)
        eq(result, "complete", "third")
        s, result = Rules.step(s, "air", 103, 6, true, true)
        eq(result, "cooldown", "no farming")
        s, result = Rules.step(s, "air", 193, 6, true, true)
        eq(result, "progress", "replay after cooldown")
    end)
    test("wind rune puzzle rejects remote abuse and resets bad order", function()
        local s, result = Rules.step(nil, "storm", 100, 2, true, true)
        eq(result, "reset", "wrong first")
        s, result = Rules.step(s, "air", 100.1, 2, true, true)
        eq(result, "too_fast", "spam")
        s, result = Rules.step(s, "air", 101, 99, true, true)
        eq(result, "invalid", "distance")
        s, result = Rules.step(s, "air", 101, 2, false, true)
        eq(result, "invalid", "dead")
        s, result = Rules.step(s, "air", 101, 2, true, false)
        eq(result, "invalid", "no profile")
        s, result = Rules.step(s, "air", 101, 2, true, true)
        eq(result, "progress", "valid")
        s, result = Rules.step(s, "rain", 138, 2, true, true)
        eq(result, "reset", "expired")
    end)
end
