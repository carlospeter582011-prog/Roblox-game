local Rules = require("../src/shared/BossChallengeRules")
return function(test, eq)
    test("boss phases advance at one-third and two-thirds catch progress", function()
        eq(Rules.phase(0, 7), 1, "opening")
        eq(Rules.phase(3, 7), 2, "pressure")
        eq(Rules.phase(5, 7), 3, "final")
        eq(Rules.phase(0, 3), 1, "meadow opening")
        eq(Rules.phase(1, 3), 2, "meadow pressure")
        eq(Rules.phase(2, 3), 3, "meadow final")
        eq(Rules.phase(-1, 0), 1, "invalid goal")
    end)

    test("boss phase announcements are stage-specific", function()
        eq(string.find(Rules.phaseMessage(2, "Warden"), "gathering storm energy") ~= nil, true, "pressure text")
        eq(string.find(Rules.phaseMessage(3, "Warden"), "final phase") ~= nil, true, "final text")
    end)

    test("boss challenges enforce island progression", function()
        eq(Rules.canStart("meadow", 0), true, "starter")
        eq(Rules.canStart("eastwind", 24), false, "eastwind locked")
        eq(Rules.canStart("eastwind", 25), true, "eastwind open")
        eq(Rules.canStart("ridge", 74), false, "ridge locked")
        eq(Rules.canStart("ridge", 75), true, "ridge open")
        eq(Rules.canStart("unknown", 999), false, "invalid id")
        eq(Rules.canStart("meadow", nil), false, "missing profile")
    end)
    test("boss trial counts only newly caught clouds and clamps", function()
        eq(Rules.progress(10, 10, 3), 0, "zero")
        eq(Rules.progress(10, 12, 3), 2, "progress")
        eq(Rules.progress(10, 15, 3), 3, "clamped")
        eq(Rules.progress(10, 9, 3), 0, "nonnegative")
        eq(Rules.progress(nil, 12, 3), 0, "invalid")
    end)
    test("boss timer expires before granting late completion", function()
        eq(Rules.status(10, 13, 3, 90, 90), "complete", "deadline inclusive")
        eq(Rules.status(10, 13, 3, 90, 90.1), "expired", "late")
        eq(Rules.status(10, 12, 3, 90, 80), "active", "active")
        eq(Rules.status(10, 12, 3, nil, 80), "invalid", "invalid")
    end)
end
