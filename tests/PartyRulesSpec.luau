return function(test, eq)
    local R = require("../src/shared/PartyRules")
    test("party invite acceptance and max four members", function()
        local s = R.new()
        eq(R.invite(s, 1, 2, 0), true)
        eq(R.accept(s, 2, 1, 1), true)
        for id = 3, 4 do
            eq(R.invite(s, 1, id, id), true)
            eq(R.accept(s, id, 1, id + 0.1), true)
        end
        eq(#R.members(s, 1), 4)
        eq(R.invite(s, 1, 5, 10), false)
    end)
    test("party invitations expire and cannot be hijacked", function()
        local s = R.new()
        eq(R.invite(s, 1, 2, 0), true)
        eq(R.accept(s, 2, 3, 1), false)
        eq(R.accept(s, 2, 1, 61), false)
        eq(R.accept(s, 2, 1, 62), false)
    end)
    test("party leader handoff and stale invite rejection", function()
        local s = R.new()
        R.invite(s, 1, 2, 0)
        R.accept(s, 2, 1, 1)
        R.invite(s, 1, 3, 2)
        R.leave(s, 1)
        eq(R.members(s, 2)[1], 2)
        eq(R.accept(s, 3, 1, 3), false)
        eq(R.invite(s, 2, 3, 4), true)
        eq(R.accept(s, 3, 2, 5), true)
    end)
    test("leaving cancels outstanding invites even before a party forms", function()
        local s = R.new()
        eq(R.invite(s, 1, 2, 0), true)
        eq(R.leave(s, 1), false)
        eq(R.accept(s, 2, 1, 1), false)
        eq(R.invite(s, 1, 2, 2), true)
        eq(R.accept(s, 2, 1, 62), false)
    end)
    test("invalid clocks cannot extend invitations indefinitely", function()
        local s = R.new()
        eq(R.invite(s, 1, 2, math.huge), false)
        eq(R.invite(s, 1, 2, 0 / 0), false)
        eq(R.invite(s, 1, 2, 0), true)
        eq(R.accept(s, 2, 1, math.huge), false)
        eq(R.accept(s, 2, 1, 1), true)
    end)
    test("non-leaders cannot invite and IDs must be valid", function()
        local s = R.new()
        R.invite(s, 1, 2, 0)
        R.accept(s, 2, 1, 1)
        eq(R.invite(s, 2, 3, 2), false)
        eq(R.invite(s, -1, 3, 2), false)
        eq(R.invite(s, 1, 1, 2), false)
    end)
end
