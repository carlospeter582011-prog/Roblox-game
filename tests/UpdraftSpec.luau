return function(test, eq)
    local Rules = require("../src/shared/UpdraftRules")
    test("updraft rejects distant, dead and unloaded players", function()
        eq(Rules.canLaunch(16, 10, nil, true, true), false, "distance")
        eq(Rules.canLaunch(4, 10, nil, false, true), false, "profile")
        eq(Rules.canLaunch(4, 10, nil, true, false), false, "dead")
        eq(Rules.canLaunch(4, 10, nil, true, true), true, "eligible")
    end)
    test("updraft cooldown rejects repeat and clock rollback", function()
        eq(Rules.canLaunch(4, 17, 10, true, true), false, "cooldown")
        eq(Rules.canLaunch(4, 18, 10, true, true), true, "elapsed")
        eq(Rules.canLaunch(4, 9, 10, true, true), false, "clock rollback")
    end)
    test("updraft rejects invalid numbers and directions", function()
        eq(Rules.canLaunch(0/0, 10, nil, true, true), false, "nan distance")
        eq(Rules.canLaunch(3, math.huge, nil, true, true), false, "infinite clock")
        eq(Rules.launchSpeeds(0, 0), nil, "zero direction")
        eq(Rules.launchSpeeds(math.huge, 1), nil, "invalid direction")
    end)
    test("updraft velocity is normalized and bounded", function()
        local x, y, z = Rules.launchSpeeds(3, 4)
        eq(x, 21.6, "horizontal x")
        eq(y, 42, "vertical")
        eq(z, 28.8, "horizontal z")
    end)
end
