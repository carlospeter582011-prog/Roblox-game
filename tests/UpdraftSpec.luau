return function(test, eq)
    local Rules = require("../src/shared/UpdraftRules")
    test("updraft progression gates regions", function()
        eq(Rules.canLaunch("eastwind", 2, 4, 30, nil, true), false, "locked")
        eq(Rules.canLaunch("eastwind", 3, 4, 30, nil, true), true, "unlocked")
        eq(Rules.canLaunch("ridge", 5, 4, 30, nil, true), true, "ridge unlocked")
    end)
    test("updraft validates distance, readiness, cooldown and unknown ids", function()
        eq(Rules.canLaunch("bad", 99, 1, 30, nil, true), false, "unknown")
        eq(Rules.canLaunch("meadow", 99, 14, 30, nil, true), false, "distance")
        eq(Rules.canLaunch("meadow", 99, 2, 30, nil, false), false, "not ready")
        eq(Rules.canLaunch("meadow", 99, 2, 30, 25, true), false, "cooldown")
        eq(Rules.canLaunch("meadow", 99, 2, 37, 25, true), true, "cooldown ends")
        eq(Rules.canLaunch("meadow", 99, 0/0, 30, nil, true), false, "nan distance")
    end)
end
