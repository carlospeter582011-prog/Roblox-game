return function(test, eq)
    local Glide = require("../src/shared/CloudGlideRules")
    test("glide requires earned catches and an airborne living character", function()
        eq(Glide.canStart(4, true, false, 100, nil), false, "locked")
        eq(Glide.canStart(5, true, true, 100, nil), false, "grounded")
        eq(Glide.canStart(5, false, false, 100, nil), false, "dead")
        eq(Glide.canStart(5, true, false, 100, nil), true, "eligible")
    end)
    test("glide cooldown prevents repeated activation", function()
        eq(Glide.canStart(5, true, false, 110, 100), false, "cooldown")
        eq(Glide.canStart(5, true, false, 112, 100), true, "ready")
    end)
    test("glide speed and descent are bounded", function()
        local x,y,z = Glide.velocity(3,4,-100)
        eq(math.floor(math.sqrt(x*x+z*z)+0.5),26,"horizontal speed")
        eq(y,-9,"fall cap")
        local _,rise = Glide.velocity(0,0,2)
        eq(rise,2,"no upward boost")
    end)
end
