return function(test, eq)
    local R = require("../src/shared/SkyRuneRules")
    test("sky rune puzzle requires correct order and pays once", function()
        local s, result = R.step(nil, 2, 100)
        eq(result, "progress", "first rune")
        s, result = R.step(s, 4, 105)
        eq(result, "progress", "second")
        s, result = R.step(s, 1, 110)
        eq(result, "progress", "third")
        s, result = R.step(s, 3, 115)
        eq(result, "complete", "fourth")
        s, result = R.step(s, 2, 116)
        eq(result, "cooldown", "cannot farm")
        s, result = R.step(s, 2, 295)
        eq(result, "progress", "replay after cooldown")
    end)
    test("sky rune wrong order and timeout reset progress", function()
        local s, result = R.step(nil, 4, 10)
        eq(result, "reset", "wrong first")
        s = R.step(s, 2, 11)
        s, result = R.step(s, 4, 62)
        eq(result, "reset", "expired sequence")
        s, result = R.step(s, 0, 63)
        eq(result, "invalid", "invalid rune")
        s, result = R.step(s, 2, math.huge)
        eq(result, "invalid", "invalid clock")
    end)
end
