return function(test, eq)
    local Rules = require("../src/shared/CatchStreakRules")

    test("catch streak starts and expires after 30 seconds", function()
        eq(Rules.advance(nil, nil, 100), 1, "first catch")
        eq(Rules.advance(1, 100, 130), 2, "exact boundary")
        eq(Rules.advance(2, 100, 131), 1, "expired")
        eq(Rules.advance(3, 200, 150), 1, "clock rollback")
    end)

    test("catch streak awards bounded XP at milestones", function()
        eq(Rules.bonusXp(1), 0, "initial catch")
        eq(Rules.bonusXp(2), 0, "second catch")
        eq(Rules.bonusXp(3), 3, "three catches")
        eq(Rules.bonusXp(6), 6, "six catches")
        eq(Rules.bonusXp(12), 12, "twelve catches")
        eq(Rules.bonusXp(20), 12, "bonus capped")
        eq(Rules.advance(20, 100, 101), 20, "streak capped")
    end)

    test("invalid or malicious streak values cannot grant XP", function()
        eq(Rules.bonusXp(-1), 0, "negative")
        eq(Rules.bonusXp(math.huge), 0, "infinity")
        eq(Rules.bonusXp(0 / 0), 0, "NaN")
        eq(Rules.bonusXp("999"), 0, "string")
        eq(Rules.advance(math.huge, 100, 110), 1, "invalid previous")
        eq(Rules.advance(10, 100, math.huge), 0, "invalid now")
    end)
end
