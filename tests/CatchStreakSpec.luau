return function(test, eq)
    local Rules = require("../src/shared/CatchStreakRules")
    test("catch streak starts at one and grows within window", function()
        eq(Rules.next(nil, nil, 100), 1, "first")
        eq(Rules.next(1, 100, 144), 2, "within")
        eq(Rules.next(2, 100, 145), 3, "boundary")
        eq(Rules.next(2, 100, 146), 1, "expired")
        eq(Rules.next(2, 150, 100), 1, "clock reversal")
    end)
    test("streak is capped and only grants bounded XP at milestones", function()
        eq(Rules.next(10, 100, 101), 10, "cap")
        eq(Rules.bonusXp(1, 100), 0, "first")
        eq(Rules.bonusXp(3, 100), 10, "third")
        eq(Rules.bonusXp(6, 100), 20, "sixth")
        eq(Rules.bonusXp(9, 100), 30, "ninth")
        eq(Rules.bonusXp(1000, 100), 30, "bonus cap")
        eq(Rules.bonusXp(9, math.huge), 0, "invalid xp")
    end)
end
