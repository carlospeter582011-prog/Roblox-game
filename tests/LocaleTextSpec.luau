return function(test, eq)
    local Locale = require("../src/shared/LocaleText")
    test("locale supports Arabic and English with fallback", function()
        eq(Locale.normalize("ar"), "ar", "Arabic")
        eq(Locale.normalize("xx"), "en", "fallback")
        eq(Locale.text("ar", "shop"), "المتجر", "Arabic shop")
        eq(Locale.text("en", "shop"), "Shop", "English shop")
        eq(Locale.text("xx", "coins"), "Coins", "fallback text")
        eq(Locale.text("ar", "unknown_key"), "unknown_key", "missing key")
    end)
    test("compact numbers handle boundaries and unsafe inputs", function()
        eq(Locale.number(999), "999", "under 1K")
        eq(Locale.number(1000), "1.0K", "one thousand")
        eq(Locale.number(1599), "1.5K", "floor rounding")
        eq(Locale.number(1234567), "1.2M", "millions")
        eq(Locale.number(-1200), "-1.2K", "negative")
        eq(Locale.number(0/0), "0", "NaN")
        eq(Locale.number(math.huge), "0", "infinity")
        eq(Locale.number("oops"), "0", "non-number")
    end)
end
