return function(test, eq)
    local Rules = require("../src/shared/SkyChimeRules")
    test("sky chime cooperative sequence unlocks for 45 seconds", function()
        local state, outcome
        for _, id in ipairs({2, 1, 3, 2}) do
            state, outcome = Rules.advance(state, id, 100)
        end
        eq(outcome, "solved", "sequence")
        eq(Rules.isOpen(state, 144), true, "open")
        eq(Rules.isOpen(state, 145), false, "expires")
    end)
    test("sky chime wrong step and timeout reset sequence", function()
        local state = Rules.advance(nil, 2, 100)
        state = Rules.advance(state, 3, 101)
        eq(state.step, 1, "reset")
        local _, outcome = Rules.advance(state, 2, 102)
        eq(outcome, "cooldown", "cooldown")
        state = Rules.advance(state, 2, 105)
        state = Rules.advance(state, 1, 124)
        eq(state.step, 1, "timed out")
    end)
    test("sky chime rejects invalid inputs", function()
        local state, reason = Rules.advance(nil, 0, 100)
        eq(state, nil, "invalid id")
        eq(reason, "invalid_chime", "reason")
        state = Rules.advance(nil, 2, 0 / 0)
        eq(state, nil, "invalid clock")
    end)
end
