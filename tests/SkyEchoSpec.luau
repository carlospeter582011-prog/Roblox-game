return function(test, eq)
    local Rules = require("../src/shared/SkyEchoRules")
    test("Sky Echo trail validates order, cooldown timing, distance and profile readiness", function()
        eq(#Rules.points, 3, "three checkpoints")
        eq(Rules.canVisit(1, 1, 0, 10, true), true, "first visit")
        eq(Rules.canVisit(2, 1, 100, 10, true), false, "wrong order")
        eq(Rules.canVisit(2, 2, 2, 10, true), false, "too fast")
        eq(Rules.canVisit(2, 2, 5, 15, true), false, "too far")
        eq(Rules.canVisit(2, 2, 5, 10, false), false, "unready")
        eq(Rules.canVisit(2, 2, 5, math.huge, true), false, "nonfinite distance")
        eq(Rules.canVisit(2, 2, 3, 14, true), true, "valid second")
    end)
    test("Sky Echo completes only after final checkpoint", function()
        local nextIndex, done = Rules.advance(2)
        eq(nextIndex, 3, "third follows second")
        eq(done, false, "not yet done")
        nextIndex, done = Rules.advance(3)
        eq(nextIndex, nil, "completed")
        eq(done, true, "completion")
    end)
end
