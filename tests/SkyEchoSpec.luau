local Rules = require("../src/shared/SkyEchoRules")
assert(#Rules.points == 3)
assert(Rules.canVisit(1, 1, 0, 10, true))
assert(not Rules.canVisit(2, 1, 100, 10, true))
assert(not Rules.canVisit(2, 2, 2, 10, true))
assert(not Rules.canVisit(2, 2, 5, 15, true))
assert(not Rules.canVisit(2, 2, 5, 10, false))
assert(not Rules.canVisit(2, 2, 5, math.huge, true))
assert(Rules.canVisit(2, 2, 3, 14, true))
local nextIndex, done = Rules.advance(3)
assert(nextIndex == nil and done == true)
print("Sky Echo rules: 9 assertions passed")
