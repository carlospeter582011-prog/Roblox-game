return function(test, eq)
    local Rules = require("../src/shared/SkyRelayRules")
    test("relay requires ordered checkpoints and legitimate duration", function()
        local state, result = Rules.advance(nil, 1, 100)
        eq(result, "started", "start")
        local invalid, reason = Rules.advance(state, 3, 110)
        eq(invalid, nil, "cannot skip checkpoint")
        eq(reason, "order", "order error")
        local second = Rules.advance(state, 2, 104)
        local finish, done = Rules.advance(second, 3, 112)
        eq(done, "finished", "complete")
        eq(finish.finished, 12, "server time")
    end)
    test("relay rejects speed exploits, stale runs and restart spam", function()
        local state = Rules.advance(nil, 1, 10)
        eq(select(1, Rules.advance(state, 1, 11)), nil, "restart cooldown")
        local second = Rules.advance(state, 2, 12)
        eq(select(1, Rules.advance(second, 3, 13)), nil, "too fast")
        eq(select(1, Rules.advance(second, 3, 300)), nil, "expired")
    end)
    test("relay rejects malformed checkpoints and clocks", function()
        eq(select(1, Rules.advance(nil, 0, 10)), nil, "zero")
        eq(select(1, Rules.advance(nil, 2.5, 10)), nil, "fraction")
        eq(select(1, Rules.advance(nil, 1, 0/0)), nil, "nan")
        eq(select(1, Rules.advance(nil, 1, math.huge)), nil, "infinity")
    end)
end
