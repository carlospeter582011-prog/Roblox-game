return function(test, eq)
    local Rules = require("../src/shared/SkyRelayRules")
    test("relay requires ordered three-region traversal", function()
        local ok, state, status = Rules.advance(nil, "meadow", 100, 4, true, true)
        eq(ok, true, "start")
        eq(state.step, 2, "next eastwind")
        ok, state = Rules.advance(state, "ridge", 120, 4, true, true)
        eq(ok, false, "skip rejected")
        eq(state.step, 2, "state intact")
        ok, state = Rules.advance(state, "eastwind", 130, 4, true, true)
        eq(ok, true, "eastwind")
        ok, state, status = Rules.advance(state, "ridge", 150, 4, true, true)
        eq(ok, true, "ridge")
        eq(status, "complete", "completed")
        eq(state.nextAt, 300, "cooldown")
        ok = Rules.advance(state, "meadow", 200, 4, true, true)
        eq(ok, false, "cooldown enforced")
    end)
    test("relay rejects invalid, dead, unloaded and distant activations", function()
        for _, distance in ipairs({ -1, 14, math.huge }) do
            local ok = Rules.advance(nil, "meadow", 10, distance, true, true)
            eq(ok, false, "distance")
        end
        eq(Rules.advance(nil, "meadow", 10, 2, false, true), false, "dead")
        eq(Rules.advance(nil, "meadow", 10, 2, true, false), false, "unloaded")
        eq(Rules.advance(nil, "meadow", 0/0, 2, true, true), false, "NaN time")
    end)
    test("relay expires incomplete sequences and requires restart", function()
        local _, state = Rules.advance(nil, "meadow", 100, 2, true, true)
        local ok, expired = Rules.advance(state, "eastwind", 191, 2, true, true)
        eq(ok, false, "expired")
        eq(expired.step, 1, "reset to first")
        ok, expired = Rules.advance(expired, "meadow", 192, 2, true, true)
        eq(ok, true, "can restart")
        eq(expired.step, 2, "next")
    end)
end
