return function(test, eq)
    local R = require("../src/shared/SkyRelayRules")
    test("relay requires sequential beacon visits", function()
        eq(R.advance(0, "outlook", 1, 2), nil, "skip rejected")
        eq(R.advance(0, "meadow", 1, 2), 1, "start")
        eq(R.advance(1, "outlook", 50, 3), 2, "middle")
        eq(R.advance(2, "ridge", 179, 2), 3, "finish")
        eq(R.advance(3, "ridge", 10, 1), nil, "no double finish")
    end)
    test("relay rejects impossible timestamps and distances", function()
        eq(R.advance(0, "meadow", math.huge, 2), nil, "infinite time")
        eq(R.advance(0, "meadow", -1, 2), nil, "negative time")
        eq(R.advance(0, "meadow", 181, 2), nil, "expired")
        eq(R.advance(0, "meadow", 1, 15), nil, "distance")
        eq(R.advance(0, "meadow", 1, 0/0), nil, "NaN")
        eq(R.advance(0/0, "meadow", 1, 2), nil, "NaN stage")
    end)
    test("relay replay cooldown cannot be bypassed", function()
        eq(R.canStart(1000, nil), true, "first")
        eq(R.canStart(1599, 1000), false, "cooldown")
        eq(R.canStart(1600, 1000), true, "replay")
        eq(R.canStart(1000, math.huge), false, "invalid finish")
        eq(R.canStart(-1, nil), false, "invalid clock")
    end)
end
