return function(test, eq)
    local Rules = require("../src/shared/CloudRescueRules")
    test("rescue relay requires ordered stages and independent time window", function()
        local a, status = Rules.step(nil, 1, 100, 4, true)
        eq(status, "progress", "start")
        eq(Rules.step(a, 3, 101, 4, true), nil, "skip rejected")
        local b = Rules.step(a, 2, 115, 4, true)
        local c, done = Rules.step(b, 3, 130, 4, true)
        eq(done, "complete", "completed")
        eq(c.cooldownUntil, 230, "cooldown starts on completion")
        eq(Rules.step(c, 1, 150, 4, true), nil, "cooldown enforced")
        eq(select(2, Rules.step(c, 1, 230, 4, true)), "progress", "cooldown expires")
    end)
    test("rescue relay rejects invalid inputs and expired progress", function()
        eq(Rules.step(nil, 1, 1, 2, false), nil, "unloaded profile")
        eq(Rules.step(nil, 1, 1, math.huge, true), nil, "infinite distance")
        eq(Rules.step(nil, 1, 1, 0 / 0, true), nil, "nan distance")
        eq(Rules.step(nil, 1, 1, 16, true), nil, "out of range")
        eq(Rules.step(nil, 0, 1, 2, true), nil, "invalid stage")
        local a = Rules.step(nil, 1, 10, 2, true)
        eq(Rules.step(a, 2, 76, 2, true), nil, "expired progress")
        eq(select(2, Rules.step(a, 1, 76, 2, true)), "progress", "can restart")
    end)
end
