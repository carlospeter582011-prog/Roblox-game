return function(test, eq)
    local Rules = require("../src/shared/CloudCareRules")
    test("care requires owned companion, sufficient coins and elapsed cooldown", function()
        eq(Rules.evaluate(45, 0, true, 300), true, "valid")
        eq(Rules.evaluate(44, 0, true, 300), false, "poor")
        eq(Rules.evaluate(45, 0, false, 300), false, "unowned")
        eq(Rules.evaluate(45, 0, true, 299), false, "cooldown")
    end)
    test("care bond gain is capped and invalid values rejected", function()
        local ok, points = Rules.evaluate(45, 39, true, 300)
        eq(ok, true, "valid")
        eq(points, 44, "five points")
        eq(Rules.evaluate(45, 1000000, true, 300), false, "cap")
        eq(Rules.evaluate(math.huge, 0, true, 300), false, "infinite currency")
    end)
end
