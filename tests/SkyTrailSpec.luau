return function(test, eq)
    local R = require("../src/shared/SkyTrailRules")
    test("sky trail validates sequential three-beacon finish", function()
        local s, reason = R.begin(nil, 100)
        eq(reason, "started", "start")
        local a, r1 = R.advance(s, 1, 120)
        eq(r1, "checkpoint", "first")
        local b, r2 = R.advance(a, 2, 145)
        eq(r2, "checkpoint", "second")
        local c, r3 = R.advance(b, 3, 160)
        eq(r3, "finished", "finish")
        eq(c.elapsed, 60, "elapsed")
        eq(c.finished, true, "finished flag")
    end)
    test("sky trail blocks skips, repeats and invalid checkpoints", function()
        local s = R.begin(nil, 100)
        eq(select(2, R.advance(s, 2, 110)), "out_of_order", "skip")
        eq(select(2, R.advance(s, 1.5, 110)), "invalid", "fractional")
        local a = R.advance(s, 1, 110)
        eq(select(2, R.advance(a, 1, 120)), "out_of_order", "repeat")
        eq(select(2, R.advance(a, 3, 120)), "out_of_order", "skip second")
    end)
    test("sky trail rejects clock rollback and expired attempts", function()
        local s = R.begin(nil, 100)
        eq(select(2, R.advance(s, 1, 99)), "expired", "rollback")
        eq(select(2, R.advance(s, 1, 281)), "expired", "time limit")
        eq(select(2, R.begin(nil, math.huge)), "invalid_time", "infinite clock")
        eq(select(2, R.advance(s, 1, 0/0)), "invalid", "NaN clock")
    end)
    test("sky trail cooldown blocks rapid replay and allows later attempts", function()
        local s = R.begin(nil, 100)
        local a = R.advance(s, 1, 110)
        local b = R.advance(a, 2, 120)
        local c = R.advance(b, 3, 130)
        eq(select(2, R.begin(c, 140)), "cooldown", "blocked")
        eq(select(2, R.begin(c, 190)), "started", "replay")
    end)
end
