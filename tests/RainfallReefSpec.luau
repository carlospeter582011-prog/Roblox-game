return function(test, eq)
    local Reef = require("../src/shared/RainfallReefRules")
    local Spawn = require("../src/shared/SpawnRules")
    test("rainfall reef has a continuous walkable bridge overlap", function()
        eq(Reef.isOnWalkway(370, 0), true, "ridge overlap")
        eq(Reef.isOnWalkway(405, 0), true, "reef overlap")
        eq(Reef.isInside(405, 0), true, "reef entry")
        eq(Reef.isInside(515, 0), true, "reef far edge")
        eq(Reef.isInside(520, 0), false, "off reef")
    end)
    test("rainfall reef unlock requires finite earned catches", function()
        eq(Reef.canTravel(24), false, "locked")
        eq(Reef.canTravel(25), true, "unlocked")
        eq(Reef.canTravel(0 / 0), false, "nan")
        eq(Reef.canTravel(math.huge), false, "infinite")
        eq(Spawn.canFastTravel("rainfall", 24), false, "station locked")
        eq(Spawn.canFastTravel("rainfall", 25), true, "station unlocked")
    end)
    test("rainfall spawn positions stay on the solid floor", function()
        local r = Spawn.regionBounds(6)
        eq(r.name, "RainfallReef", "region")
        eq(Reef.isInside(r.minX, r.minZ), true, "southwest")
        eq(Reef.isInside(r.maxX, r.maxZ), true, "northeast")
    end)
end
