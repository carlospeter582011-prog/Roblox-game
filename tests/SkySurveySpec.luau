return function(test, eq)
    local Rules = require("../src/shared/SkySurveyRules")
    test("survey requires ordered 3D checkpoints and completes", function()
        local step, result = Rules.advance(1, "meadow", 0, 3)
        eq(step, 2, "start")
        eq(result, "progress", "started")
        step = Rules.advance(step, "eastwind", 45, 4)
        eq(step, 3, "second")
        step, result = Rules.advance(step, "ridge", 89, 5)
        eq(step, 4, "finished")
        eq(result, "complete", "complete")
    end)
    test("survey rejects skipping, remote activation and malformed time", function()
        eq(Rules.advance(1, "ridge", 1, 3), nil, "skipped")
        eq(Rules.advance(1, "meadow", 1, 17), nil, "distance")
        eq(Rules.advance(1, "meadow", math.huge, 1), nil, "infinity")
        eq(Rules.advance(1, "meadow", 181, 1), nil, "timeout")
        eq(Rules.advance(1, "meadow", 1, 0/0), nil, "nan distance")
        eq(Rules.advance(0, "meadow", 1, 1), nil, "invalid index")
    end)
    test("survey personal best never gets worse", function()
        eq(Rules.best(nil, 90), 90, "first")
        eq(Rules.best(90, 120), 90, "slower")
        eq(Rules.best(90, 75), 75, "faster")
        eq(Rules.best(90, math.huge), 90, "invalid")
    end)
end
