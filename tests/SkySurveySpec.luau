return function(test, eq)
    local R = require("../src/shared/SkySurveyRules")
    test("sky survey requires ordered physical visits", function()
        local state, result = R.advance(nil, 2, 100)
        eq(result, "start_at_one", "must start first")
        state, result = R.advance(nil, 1, 100)
        eq(result, "started", "start")
        local unchanged, bad = R.advance(state, 3, 105)
        eq(bad, "wrong_order", "cannot skip")
        eq(unchanged.next, 2, "state unchanged")
        state, result = R.advance(state, 2, 110)
        eq(result, "advanced", "second lens")
        state, result = R.advance(state, 3, 115)
        eq(result, "complete", "third lens")
        eq(state.cooldownUntil, 115 + R.COOLDOWN, "cooldown")
    end)
    test("sky survey expiry, cooldown and invalid input", function()
        local state = R.advance(nil, 1, 0)
        local expired, result = R.advance(state, 3, R.TIME_LIMIT + 1)
        eq(result, "start_at_one", "expired cannot finish")
        eq(expired, nil, "expired reset")
        local complete = {cooldownUntil=500}
        local blocked, status = R.advance(complete, 1, 499)
        eq(status, "cooldown", "replay blocked")
        eq(blocked.cooldownUntil, 500, "cooldown intact")
        local invalid, err = R.advance(nil, 1.5, 0)
        eq(err, "invalid", "integer station")
        eq(invalid, nil, "no progress")
    end)
end
