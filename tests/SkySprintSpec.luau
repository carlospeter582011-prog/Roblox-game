local Rules = require("../src/shared/SkySprintRules")
local function eq(a,b) assert(a==b, tostring(a).." ~= "..tostring(b)) end
local state = assert(Rules.start(100))
eq(Rules.advance(state, 3, 101), "out_of_order")
eq(state.next, 2)
eq(Rules.advance(state, 2, 102), "advanced")
eq(Rules.advance(state, 3, 103), "advanced")
eq(Rules.advance(state, 4, 104), "advanced")
eq(Rules.advance(state, 5, 105), "finished")
eq(Rules.start(200, 105), nil)
local second = assert(Rules.start(300, 105))
eq(Rules.advance(second, 2, 301), "out_of_order")
eq(Rules.advance(second, 2, 302), "advanced")
eq(Rules.advance(second, 3, 303), "advanced")
eq(Rules.advance(second, 4, 303), "advanced")
eq(Rules.advance(second, 5, 303), "too_fast")
eq(Rules.advance(second, 5, 400), "expired")
return true
