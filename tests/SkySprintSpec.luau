return function(test, eq)
    local Rules = require("../src/shared/SkySprintRules")
    test("sky sprint enforces gate order and awards only on valid finish", function()
        local state = assert(Rules.start(100))
        eq(Rules.advance(state, 3, 101), "out_of_order")
        eq(state.next, 2)
        eq(Rules.advance(state, 2, 102), "advanced")
        eq(Rules.advance(state, 3, 103), "advanced")
        eq(Rules.advance(state, 4, 104), "advanced")
        eq(Rules.advance(state, 5, 105), "finished")
        eq(Rules.start(200, 105), nil)
    end)
    test("sky sprint rejects instant completion and expiry", function()
        local state = assert(Rules.start(300, 105))
        eq(Rules.advance(state, 2, 301), "advanced")
        eq(Rules.advance(state, 3, 302), "advanced")
        eq(Rules.advance(state, 4, 303), "advanced")
        eq(Rules.advance(state, 5, 303), "too_fast")
        eq(Rules.advance(state, 5, 400), "expired")
        eq(Rules.advance(nil, 2, 301), "invalid")
    end)
end
