return function(test, eq)
    local Rules = require("../src/shared/SkyBeaconRules")
    test("sky beacons require a valid server checkpoint and living ready player", function()
        eq(Rules.canActivate("ridge", 10, true, true), true, "valid")
        eq(Rules.canActivate("unknown", 1, true, true), false, "unknown")
        eq(Rules.canActivate("ridge", 15, true, true), false, "too far")
        eq(Rules.canActivate("ridge", -1, true, true), false, "negative")
        eq(Rules.canActivate("ridge", 0/0, true, true), false, "nan")
        eq(Rules.canActivate("ridge", math.huge, true, true), false, "infinite")
        eq(Rules.canActivate("ridge", 2, false, true), false, "dead")
        eq(Rules.canActivate("ridge", 2, true, false), false, "not ready")
    end)
    test("sky beacon destination uses allowlisted world coordinates", function()
        eq(Rules.spawnPosition("ridge").x, 315, "ridge x")
        eq(Rules.spawnPosition("invalid").x, 0, "fallback meadow")
    end)
end
