return function(test, eq)
    local Rules = require("../src/shared/SkyBeaconRules")
    test("beacon counts only newly caught clouds and bounds corrupted counters", function()
        eq(Rules.progress(10, 13), 3, "delta")
        eq(Rules.progress(10, 8), 0, "negative")
        eq(Rules.progress(0, math.huge), 0, "infinite")
        eq(Rules.progress(0/0, 5), 0, "nan")
    end)
    test("beacon requires real participation and respects expiry", function()
        eq(Rules.eligible(1), false, "one catch")
        eq(Rules.eligible(2), true, "two catches")
        eq(Rules.status(12, 100, 100), "complete", "on deadline")
        eq(Rules.status(12, 100, 101), "expired", "expired first")
        eq(Rules.status(11, 100, 90), "active", "in progress")
    end)
end
