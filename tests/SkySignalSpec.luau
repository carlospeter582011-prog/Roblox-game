return function(test, eq)
    local R = require("../src/shared/SkySignalRules")
    test("sky signals require ordered beacons", function()
        eq(R.next(1,"eastwind",10,20),nil,"cannot skip")
        eq(R.next(1,"meadow",10,20),2,"first")
        eq(R.next(2,"eastwind",10,25),3,"second")
        eq(R.next(3,"ridge",10,30),4,"complete")
        eq(R.next(3,"ridge",10,191),nil,"expired")
    end)
    test("sky signals reject malformed time and cooldown bypass", function()
        eq(R.next(1,"meadow",10,9),nil,"clock reversal")
        eq(R.next(1,"meadow",10,math.huge),nil,"infinite time")
        eq(R.next(0,"meadow",10,20),nil,"invalid step")
        eq(R.canStart(99,100),false,"cooldown")
        eq(R.canStart(100,100),true,"ready")
        eq(R.canStart(math.huge,0),false,"invalid")
    end)
end
