return function(test, eq)
    local Rules = require("../src/shared/CatchSafetyRules")
    test("catch guard rejects invalid distance and cooldown", function()
        eq(Rules.canCatch(true, 10, 12, 1, 1), true, "valid")
        eq(Rules.canCatch(true, 13, 12, 1, 1), false, "too far")
        eq(Rules.canCatch(false, 10, 12, 1, 1), false, "dead")
        eq(Rules.canCatch(true, 10, 12, 0.5, 1), false, "cooldown")
        eq(Rules.canCatch(true, 0/0, 12, 1, 1), false, "NaN")
        eq(Rules.canCatch(true, math.huge, 12, 1, 1), false, "infinite")
        eq(Rules.canCatch(true, -1, 12, 1, 1), false, "negative")
        eq(Rules.canCatch(true, 10, 0/0, 1, 1), false, "bad radius")
        eq(Rules.canCatch(true, 10, 12, math.huge, 1), false, "bad elapsed")
    end)
end
