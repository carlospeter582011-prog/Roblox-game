-- Standalone pure-Luau regression assertions; integrate with repository runner before counting as CI.
local Rules = require("../src/shared/SkyRelayRules")
local state = assert(Rules.start(nil, 10))
assert(state.index == 0)
assert(Rules.advance(state, 2, 11) == nil)
local first = assert(Rules.advance(state, 1, 11))
assert(first.index == 1)
assert(Rules.advance(first, 1, 12) == nil)
local second = assert(Rules.advance(first, 2, 15))
local final, elapsed = Rules.advance(second, 3, 20)
assert(final.index == 3 and elapsed == 10)
assert(Rules.advance(second, 3, 120) == nil)
assert(Rules.start({lastStart=10}, 11) == nil)
assert(Rules.start({lastStart=10}, 18) ~= nil)
assert(Rules.start(nil, 0/0) == nil)
print("SkyRelayRulesSpec passed")
