return function(test, eq)
    local Rules = require("../src/shared/UpdraftRules")
    test("updraft requires server distance, cooldown, profile and living player", function()
        eq(Rules.canLaunch(12, 8, true, true), true, "valid")
        eq(Rules.canLaunch(14, 8, true, true), false, "far")
        eq(Rules.canLaunch(1, 7.99, true, true), false, "cooldown")
        eq(Rules.canLaunch(1, 8, false, true), false, "dead")
        eq(Rules.canLaunch(1, 8, true, false), false, "profile")
        eq(Rules.canLaunch(0/0, 8, true, true), false, "nan")
        eq(Rules.canLaunch(1, math.huge, true, true), false, "infinite time")
    end)
    test("updraft velocity rejects invalid directions and is bounded", function()
        local x,y,z = Rules.velocity(3,4)
        eq(x,27,"horizontal x")
        eq(y,65,"vertical")
        eq(z,36,"horizontal z")
        eq(Rules.velocity(0,0),nil,"zero direction")
        eq(Rules.velocity(math.huge,1),nil,"infinite direction")
    end)
end
