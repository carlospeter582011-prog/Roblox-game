local Rules = require("../src/shared/UpdraftRules")
return function(test, eq)
    test("windlift validates distance, health and cooldown", function()
        eq(Rules.canLaunch(12, 100, 10, nil, 5), true, "initial launch")
        eq(Rules.canLaunch(14, 100, 10, nil, 5), false, "too far")
        eq(Rules.canLaunch(1, 0, 10, nil, 5), false, "dead")
        eq(Rules.canLaunch(1, 100, 12, 10, 5), false, "cooldown")
        eq(Rules.canLaunch(1, 100, 15, 10, 5), true, "cooldown elapsed")
    end)
    test("windlift rejects invalid clocks and velocity", function()
        eq(Rules.canLaunch(0/0, 100, 10, nil, 5), false, "NaN distance")
        eq(Rules.canLaunch(1, 100, math.huge, nil, 5), false, "infinite clock")
        eq(Rules.canLaunch(1, 100, 9, 10, 5), false, "clock reversal")
        eq(Rules.velocity(0, 0, 40, 70), nil, "zero direction")
        eq(Rules.velocity(1, 0, math.huge, 70), nil, "infinite speed")
        local x,y,z = Rules.velocity(3, 4, 50, 70)
        eq(x, 30, "normalized x")
        eq(y, 70, "lift")
        eq(z, 40, "normalized z")
    end)
end
