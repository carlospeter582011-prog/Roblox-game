return function(test, eq)
    local Rules = require("../src/shared/SkyRescueRules")
    test("rescue checkpoints validate IDs, distance and alive state", function()
        eq(Rules.canActivate("meadow", 10, true), true, "valid shrine")
        eq(Rules.canActivate("unknown", 2, true), false, "unknown shrine")
        eq(Rules.canActivate("ridge", 16, true), false, "out of range")
        eq(Rules.canActivate("ridge", 2, false), false, "dead")
        eq(Rules.canActivate("ridge", 0/0, true), false, "nan")
    end)
    test("fall recovery triggers only below safe altitude with cooldown", function()
        eq(Rules.shouldRescue(-40, 10, nil, true), true, "first rescue")
        eq(Rules.shouldRescue(-35, 10, nil, true), false, "at threshold")
        eq(Rules.shouldRescue(-40, 12, 10, true), false, "cooldown")
        eq(Rules.shouldRescue(-40, 13, 10, true), true, "after cooldown")
        eq(Rules.shouldRescue(-40, 15, nil, false), false, "dead")
    end)
end
