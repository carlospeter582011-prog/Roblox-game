return function(test, eq)
    local Rules = require("../src/shared/SkyRescueRules")
    test("fall rescue requires a loaded living player below the void threshold", function()
        eq(Rules.canRecover(-56, 10, nil, true, true), true, "eligible")
        eq(Rules.canRecover(-55, 10, nil, true, true), false, "boundary")
        eq(Rules.canRecover(-100, 10, nil, false, true), false, "dead")
        eq(Rules.canRecover(-100, 10, nil, true, false), false, "not loaded")
    end)
    test("fall rescue enforces cooldown and rejects invalid timestamps", function()
        eq(Rules.canRecover(-60, 15, 10, true, true), false, "cooldown")
        eq(Rules.canRecover(-60, 16, 10, true, true), true, "ready")
        eq(Rules.canRecover(-60, 0/0, nil, true, true), false, "NaN")
        eq(Rules.canRecover(-60, 3, 9, true, true), false, "clock backwards")
    end)
    test("fall rescue returns a safe region spawn without trusting client input", function()
        eq(Rules.destination(0, 0).x, 0, "meadow")
        eq(Rules.destination(165, 0).x, 170, "eastwind")
        eq(Rules.destination(310, 0).x, 315, "ridge")
        eq(Rules.destination(0/0, 0), nil, "invalid x")
        eq(Rules.destination(0, math.huge), nil, "invalid z")
    end)
end
