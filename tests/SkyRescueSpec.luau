local Rules = require("../src/shared/SkyRescueRules")
return function(test, eq)
    test("rescue checkpoints reject spoofed IDs and remote activation", function()
        eq(Rules.canActivate("ridge", 10, true), true, "valid activation")
        eq(Rules.canActivate("fake", 1, true), false, "unknown checkpoint")
        eq(Rules.canActivate("ridge", 13, true), false, "too far")
        eq(Rules.canActivate("ridge", 1, false), false, "dead player")
        eq(Rules.canActivate("ridge", 0/0, true), false, "NaN distance")
    end)
    test("fall rescue obeys height and cooldown", function()
        eq(Rules.shouldRescue(-46, 10, nil, true), true, "first fall")
        eq(Rules.shouldRescue(-46, 11, 10, true), false, "cooldown")
        eq(Rules.shouldRescue(-46, 13, 10, true), true, "cooldown elapsed")
        eq(Rules.shouldRescue(-44, 20, nil, true), false, "above threshold")
        eq(Rules.shouldRescue(-100, 20, nil, false), false, "dead")
        eq(Rules.shouldRescue(0/0, 20, nil, true), false, "invalid height")
    end)
    test("invalid saved checkpoint always falls back to meadow", function()
        eq(Rules.safeCheckpoint("ridge").x, 315, "ridge")
        eq(Rules.safeCheckpoint("untrusted").x, 0, "fallback")
    end)
end
