local Rules = require("../src/shared/SkyRescueRules")
return function(test, eq)
    test("sky rescue checkpoint requires server-verified proximity and ready profile", function()
        eq(Rules.canActivate("ridge", 9, true, true), true, "valid")
        eq(Rules.canActivate("ridge", 13, true, true), false, "too far")
        eq(Rules.canActivate("missing", 1, true, true), false, "unknown checkpoint")
        eq(Rules.canActivate("ridge", 1, false, true), false, "profile")
        eq(Rules.canActivate("ridge", 1, true, false), false, "dead")
        eq(Rules.canActivate("ridge", 0/0, true, true), false, "nan")
    end)
    test("sky rescue only fires beneath the islands after cooldown", function()
        eq(Rules.shouldRescue(-50, 100, 90, true, true), true, "rescue")
        eq(Rules.shouldRescue(-45, 100, 90, true, true), false, "height boundary")
        eq(Rules.shouldRescue(-50, 100, 98, true, true), false, "cooldown")
        eq(Rules.shouldRescue(-50, 100, 90, false, true), false, "profile")
        eq(Rules.shouldRescue(-50, 100, 90, true, false), false, "dead")
        eq(Rules.shouldRescue(-math.huge, 100, 90, true, true), false, "invalid height")
        eq(Rules.shouldRescue(-50, 90, 100, true, true), false, "clock reversal")
    end)
    test("sky rescue destinations are fixed server coordinates", function()
        eq(Rules.destination("eastwind").x, 170, "eastwind")
        eq(Rules.destination("ridge").x, 315, "ridge")
        eq(Rules.destination("fake").x, 0, "safe fallback")
    end)
end
