local Discovery = require("../src/shared/DiscoveryRewards")
local CatchRules = require("../src/shared/CatchRules")
local Catalog = require("../src/shared/CloudCatalog")
return function(test, eq)
    test("first discovery XP scales with species rarity", function()
        eq(Discovery.bonusXp(Catalog.breeze, 0), 10, "common")
        eq(Discovery.bonusXp(Catalog.thunder, 0), 35, "rare")
        eq(Discovery.bonusXp(Catalog.aurora, 0), 60, "epic")
        eq(Discovery.bonusXp(Catalog.comet, 0), 100, "legendary")
        eq(Discovery.bonusXp(Catalog.nebula, 0), 150, "mythic")
    end)
    test("repeat catches, invalid counts and unknown rarity cannot mint bonus XP", function()
        eq(Discovery.bonusXp(Catalog.breeze, 1), 0, "second catch")
        eq(Discovery.bonusXp(Catalog.breeze, 999), 0, "later catch")
        eq(Discovery.bonusXp(Catalog.breeze, -1), 0, "negative")
        eq(Discovery.bonusXp(Catalog.breeze, math.huge), 0, "infinite")
        eq(Discovery.bonusXp(nil, 0), 0, "unknown species")
        eq(Discovery.bonusXp({ rarity = "Secret" }, 0), 0, "unapproved tier")
    end)
    test("persisted species count makes first discovery a one-time catch reward", function()
        local data = { coins = 0, xp = 0, captures = 0, species = {}, quests = {} }
        for i = 1, 2 do
            local bonus = Discovery.bonusXp(Catalog.breeze, data.species.breeze or 0)
            CatchRules.applyCatch(data, "breeze", 10, {}, { xp = CatchRules.XP_PER_CATCH + bonus })
            eq(data.xp, i == 1 and 20 or 30, "XP after catch " .. i)
        end
        eq(data.species.breeze, 2, "persisted base count")
    end)
end
