local Ranks = require("../src/shared/BossTrialRanks")
return function(test, eq)
    test("boss performance rewards three bounded skill ranks", function()
        local rank, coins, xp = Ranks.evaluate(36, 90, 100, 40)
        eq(rank, "Gold", "gold at 40 percent")
        eq(coins, 25, "gold coin bonus")
        eq(xp, 10, "gold xp bonus")
        rank, coins, xp = Ranks.evaluate(63, 90, 100, 40)
        eq(rank, "Silver", "silver at 70 percent")
        eq(coins, 10, "silver coins")
        eq(xp, 4, "silver xp")
        rank, coins, xp = Ranks.evaluate(90, 90, 100, 40)
        eq(rank, "Bronze", "bronze at deadline")
        eq(coins, 0, "no bonus")
        eq(xp, 0, "no xp bonus")
    end)
    test("boss performance rejects forged and invalid inputs", function()
        eq(Ranks.evaluate(-1, 90, 100, 40), nil, "negative time")
        eq(Ranks.evaluate(91, 90, 100, 40), nil, "late")
        eq(Ranks.evaluate(math.huge, 90, 100, 40), nil, "infinite time")
        eq(Ranks.evaluate(0, 0, 100, 40), nil, "zero limit")
        eq(Ranks.evaluate(10, 90, -10, 40), nil, "negative reward")
        eq(Ranks.evaluate(10, 90, 1e12, 40), nil, "oversized reward")
        eq(Ranks.evaluate("fast", 90, 100, 40), nil, "client string")
    end)
end
