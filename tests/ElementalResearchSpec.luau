return function(test, eq)
    local Rules = require("../src/shared/ElementalResearchRules")
    local catalog = { breeze = { element = "Air" }, drizzle = { element = "Water" }, ember = { element = "Fire" }, gale = { element = "Air" } }
    test("three distinct caught elements grant exactly one research bonus", function()
        local state, xp, complete = Rules.advance(nil, "breeze", catalog)
        eq(xp, 0, "first")
        state, xp = Rules.advance(state, "gale", catalog)
        eq(xp, 0, "repeat element")
        state, xp = Rules.advance(state, "drizzle", catalog)
        eq(xp, 0, "second element")
        state, xp, complete = Rules.advance(state, "ember", catalog)
        eq(xp, 15, "third bonus")
        eq(complete, true, "completed")
        eq(next(state), nil, "resets")
        state, xp = Rules.advance(state, "ember", catalog)
        eq(xp, 0, "cannot repeat bonus immediately")
    end)
    test("unknown species and malformed elements cannot grant XP", function()
        local state, xp = Rules.advance(nil, "unknown", catalog)
        eq(xp, 0, "unknown species")
        state, xp = Rules.advance(state, "breeze", { breeze = { element = string.rep("X", 50) } })
        eq(xp, 0, "bad element")
        eq(next(state), nil, "invalid does not progress")
        state, xp = Rules.advance({ Air = true, Water = true }, "unknown", catalog)
        eq(xp, 0, "invalid cannot complete")
    end)
end
