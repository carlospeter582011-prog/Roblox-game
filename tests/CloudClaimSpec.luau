local Claims = require("../src/server/CloudClaimRules")
local guard = Claims.new()
local first = guard:claim("cloud-1")
assert(first ~= nil and guard:isClaimed("cloud-1"))
assert(guard:claim("cloud-1") == nil, "concurrent handler must not claim")
local other = guard:claim("cloud-2")
assert(other ~= nil, "independent targets must remain available")
assert(not guard:release("cloud-1", other), "wrong owner cannot release claim")
assert(guard:isClaimed("cloud-1"), "wrong-owner release must not unlock")
assert(guard:release("cloud-1", first))
local retry = guard:claim("cloud-1")
assert(retry ~= nil and retry ~= first, "failed operation can retry with new token")
assert(not guard:release("cloud-1", first), "stale owner cannot unlock a new claim")
assert(guard:isClaimed("cloud-1"))
assert(guard:release("cloud-1", retry))
assert(guard:release("cloud-2", other))
assert(not guard:isClaimed("cloud-1"))
for _, id in ipairs({"", string.rep("x", 25)}) do
    assert(guard:claim(id) == nil, "invalid cloud identifier")
end
assert(guard:claim(nil) == nil)
assert(guard:release("cloud-1", nil) == false)
return true
