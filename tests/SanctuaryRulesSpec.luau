return function(test, eq)
    local Rules = require("../src/shared/SanctuaryRules")
    test("sanctuary rejects invalid and distant activation", function()
        eq(Rules.canActivate("missing", 1, true, true, 10), false, "unknown")
        eq(Rules.canActivate("meadow", 14, true, true, 10), false, "distance")
        eq(Rules.canActivate("meadow", 1, false, true, 10), false, "not loaded")
        eq(Rules.canActivate("meadow", 1, true, false, 10), false, "dead")
        eq(Rules.canActivate("meadow", math.huge, true, true, 10), false, "infinite")
        eq(Rules.canActivate("meadow", 0 / 0, true, true, 10), false, "nan")
        eq(Rules.canActivate("meadow", -1, true, true, 10), false, "negative")
    end)
    test("sanctuary cooldown and safe respawn coordinates", function()
        eq(Rules.canActivate("ridge", 8, true, true, 10), true, "first activation")
        eq(Rules.canActivate("ridge", 8, true, true, 11, 10), false, "cooldown")
        eq(Rules.canActivate("ridge", 8, true, true, 12, 10), true, "cooldown passed")
        eq(Rules.canActivate("ridge", 8, true, true, 10, math.huge), false, "invalid last")
        local x, y, z = Rules.respawn("ridge")
        eq(x, 315, "ridge x")
        eq(y, 7, "above platform")
        eq(z, -28, "ridge z")
        eq(Rules.respawn("bogus"), nil, "unknown checkpoint")
    end)
end
