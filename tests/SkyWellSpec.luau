local Rules = require("../src/shared/SkyWellRules")
return function(test, eq)
    test("sky wells restore injured living players within activation distance", function()
        eq(Rules.eligible(10, 50, 100, 200, nil), true, "injured")
        eq(Rules.healAmount(50, 100), 35, "35 percent maximum health")
        eq(Rules.healAmount(90, 100), 10, "clamp to maximum")
    end)
    test("sky wells require a living injured activator", function()
        eq(Rules.eligible(10, 0, 100, 200, nil), false, "dead")
        eq(Rules.eligible(10, 100, 100, 200, nil), false, "full health")
        eq(Rules.eligible(18, 20, 100, 200, nil), false, "out of range")
    end)
    test("sky wells cannot be spammed or bypassed by reversing time", function()
        eq(Rules.eligible(10, 20, 100, 250, 200), false, "cooldown")
        eq(Rules.eligible(10, 20, 100, 320, 200), true, "cooldown finished")
        eq(Rules.eligible(10, 20, 100, 100, 200), false, "clock reversed")
    end)
    test("sky wells reject non-finite and invalid health inputs", function()
        eq(Rules.eligible(0/0, 20, 100, 200, nil), false, "nan distance")
        eq(Rules.eligible(10, math.huge, 100, 200, nil), false, "infinite health")
        eq(Rules.eligible(10, 20, 0, 200, nil), false, "zero max")
        eq(Rules.healAmount(-5, 100), 0, "negative health")
    end)
    test("sky wells heal allies only within their area", function()
        eq(Rules.allyEligible(19, 40, 100), true, "nearby ally")
        eq(Rules.allyEligible(21, 40, 100), false, "distant ally")
        eq(Rules.allyEligible(2, 100, 100), false, "healthy ally")
        eq(Rules.allyEligible(2, 0, 100), false, "dead ally")
    end)
end
