return function(test,eq)
 local Motion=require("../src/shared/CloudTemperament")
 test("elemental motion is bounded and repeatable",function()
   local x,y,z=Motion.offset("Storm",5,12)
   local a,b,c=Motion.offset("Storm",5,12)
   eq(x,a,"x deterministic");eq(y,b,"y deterministic");eq(z,c,"z deterministic")
   assert(math.abs(x)<=1.01 and math.abs(y)<=0.81 and math.abs(z)<=0.66,"storm bounds")
 end)
 test("different elements move differently and bad inputs stay finite",function()
   local x=Motion.offset("Ice",3,2)
   local storm=Motion.offset("Storm",3,2)
   assert(x~=storm,"elemental differences")
   local a,b,c=Motion.offset("Unknown",math.huge,0/0)
   assert(a==a and b==b and c==c,"finite fallback")
 end)
end
