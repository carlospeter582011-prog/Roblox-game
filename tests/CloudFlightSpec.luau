return function(test, eq)
    local Flight = require("../src/shared/CloudFlightRules")
    test("elemental flight paths are deterministic and bounded", function()
        local species = { element = "Storm" }
        local x,y,z = Flight.offset(species, 12, 42)
        local x2,y2,z2 = Flight.offset(species, 12, 42)
        eq(x,x2,"x deterministic")
        eq(y,y2,"y deterministic")
        eq(z,z2,"z deterministic")
        local p = Flight.parameters(species)
        assert(math.abs(x) <= p.radius and math.abs(z) <= p.radius and math.abs(y) <= p.lift)
    end)
    test("flight paths distinguish elements and reject invalid elapsed time", function()
        local sx = Flight.offset({element="Storm"}, 7, 4)
        local ix = Flight.offset({element="Ice"}, 7, 4)
        assert(sx ~= ix, "storm and ice must move differently")
        local x,y,z = Flight.offset({element="Air"}, 0/0, 3)
        assert(x == x and y == y and z == z, "finite flight coordinates")
    end)
end
