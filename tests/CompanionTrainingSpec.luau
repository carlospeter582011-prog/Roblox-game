return function(test, eq)
    local Rules = require("../src/shared/CompanionTrainingRules")
    local catalog = { breeze = { element = "Air" } }
    test("training spends earned coins and grants bounded bond", function()
        local result = Rules.train(100, "breeze", { breeze = 1 }, {}, catalog)
        eq(result.coins, 65, "wallet")
        eq(result.points, 8, "bond")
        eq(result.cost, 35, "price")
    end)
    test("training scales cost with bond and never overflows cap", function()
        eq(Rules.price(80), 45, "scaled price")
        local result = Rules.train(300, "breeze", { breeze = 2 }, { breeze = 999998 }, catalog)
        eq(result.points, 1000000, "cap")
        eq(Rules.train(300, "breeze", { breeze = 1 }, { breeze = 1000000 }, catalog), nil, "maxed")
    end)
    test("training rejects unknown or unowned species and insufficient coins", function()
        eq(Rules.train(100, "fake", { fake = 1 }, {}, catalog), nil, "unknown")
        eq(Rules.train(100, "breeze", { breeze = 0 }, {}, catalog), nil, "unowned")
        eq(Rules.train(34, "breeze", { breeze = 1 }, {}, catalog), nil, "poor")
    end)
    test("training rejects non-finite and corrupt profile fields", function()
        eq(Rules.train(math.huge, "breeze", { breeze = 1 }, {}, catalog), nil, "infinite coins")
        eq(Rules.train(100, "breeze", { breeze = 1 }, { breeze = 0/0 }, catalog), nil, "nan bond")
        eq(Rules.train(100, "breeze", { breeze = math.huge }, {}, catalog), nil, "invalid inventory")
    end)
end
