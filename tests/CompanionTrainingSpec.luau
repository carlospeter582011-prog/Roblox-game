local Rules = require("../src/shared/CompanionTrainingRules")
return function(test, eq)
    test("companion training spends Coins and advances bond in three price tiers", function()
        local a = Rules.purchase(300, 0, 200, nil)
        eq(a.coins, 255, "starter price")
        eq(a.points, 5, "starter gain")
        local b = Rules.purchase(300, 10, 200, nil)
        eq(b.coins, 210, "middle price")
        eq(b.points, 20, "middle gain")
        local c = Rules.purchase(300, 40, 200, nil)
        eq(c.coins, 140, "advanced price")
        eq(c.points, 55, "advanced gain")
        eq(Rules.purchase(300, 100, 200, nil), nil, "max level")
    end)
    test("companion training prevents cooldown bypass, insufficient funds and invalid values", function()
        eq(Rules.purchase(44, 0, 200, nil), nil, "insufficient")
        eq(Rules.purchase(100, 0, 200, 21), nil, "cooldown")
        eq(Rules.purchase(100, 0, 200, 20).points, 5, "cooldown boundary")
        eq(Rules.purchase(math.huge, 0, 200, nil), nil, "infinite coins")
        eq(Rules.purchase(100, 0/0, 200, nil), nil, "nan points")
        eq(Rules.purchase(100, -1, 200, nil), nil, "negative points")
        eq(Rules.purchase(100, 0, math.huge, nil), nil, "infinite time")
        eq(Rules.purchase(100, 0, 200, 201), nil, "future cooldown")
    end)
end
