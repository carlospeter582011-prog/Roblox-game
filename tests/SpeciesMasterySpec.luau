return function(test, eq)
    local Mastery = require("../src/shared/SpeciesMasteryRules")
    test("mastery grants exact thresholds once per species count", function()
        for _, tier in ipairs(Mastery.milestones) do
            local coins, xp, at = Mastery.reward(tier.catches - 1, tier.catches)
            eq(coins, tier.coins, "coins at milestone")
            eq(xp, tier.xp, "xp at milestone")
            eq(at, tier.catches, "milestone count")
            eq(select(1, Mastery.reward(tier.catches, tier.catches)), 0, "no duplicate")
            eq(select(1, Mastery.reward(tier.catches, tier.catches + 1)), 0, "no next-catch reward")
        end
    end)
    test("mastery rejects malformed and client-inflated counts", function()
        eq(select(1, Mastery.reward(-1, 5)), 0, "negative")
        eq(select(1, Mastery.reward(0, math.huge)), 0, "infinite")
        eq(select(1, Mastery.reward(0, 0/0)), 0, "nan")
        eq(select(1, Mastery.reward(0, 5)), 0, "skipped count")
        eq(select(1, Mastery.reward(4.5, 5)), 0, "fraction")
        eq(select(1, Mastery.reward("4", 5)), 0, "string")
    end)
    test("mastery relies on existing persistent species counts across rejoin", function()
        local Core = require("../src/server/ProfileCore")
        local old = Core.sanitize({ species = { breeze = 5 } }, {}, 0)
        eq(select(1, Mastery.reward(old.species.breeze, old.species.breeze + 1)), 0, "saved milestone cannot repeat")
        eq(select(1, Mastery.reward(14, 15)), 120, "next tier still earnable")
    end)
end
