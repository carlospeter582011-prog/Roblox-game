return function(test, eq)
    local Mastery = require("../src/shared/SpeciesMasteryRules")
    test("species mastery ranks require earned previous catches", function()
        eq(Mastery.rank(0), 0, "new species")
        eq(Mastery.rank(4), 0, "before rank one")
        eq(Mastery.rank(5), 1, "first rank")
        eq(Mastery.rank(15), 2, "second rank")
        eq(Mastery.rank(40), 3, "third rank")
        eq(Mastery.rank(100), 4, "maximum rank")
        eq(Mastery.rank(1000000), 4, "rank capped")
    end)
    test("mastery XP scales from server catch XP and is bounded", function()
        eq(Mastery.bonusXp(100, 4), 0, "not unlocked")
        eq(Mastery.bonusXp(100, 5), 5, "rank one")
        eq(Mastery.bonusXp(100, 15), 10, "rank two")
        eq(Mastery.bonusXp(100, 40), 15, "rank three")
        eq(Mastery.bonusXp(100, 100), 20, "rank four")
        eq(Mastery.bonusXp(11, 100), 2, "integer reward")
    end)
    test("mastery rejects invalid values and cannot mint XP", function()
        eq(Mastery.rank(-1), 0, "negative count")
        eq(Mastery.rank(0/0), 0, "nan count")
        eq(Mastery.rank(math.huge), 0, "infinite count")
        eq(Mastery.bonusXp(math.huge, 100), 0, "infinite xp")
        eq(Mastery.bonusXp(-10, 100), 0, "negative xp")
        eq(Mastery.bonusXp(100001, 100), 0, "oversized xp")
        eq(Mastery.bonusXp(100, -5), 0, "negative count bonus")
    end)
end
