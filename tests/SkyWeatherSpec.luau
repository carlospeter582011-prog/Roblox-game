return function(test, eq)
    local W = require("../src/shared/SkyWeatherRules")
    test("weather cycles through four phases and wraps", function()
        eq(W.phaseAt(0).id, "calm", "initial")
        eq(W.phaseAt(480).id, "tailwind", "second")
        eq(W.phaseAt(960).id, "rain", "third")
        eq(W.phaseAt(1440).id, "aurora", "fourth")
        eq(W.phaseAt(1920).id, "calm", "wrap")
    end)
    test("weather reward modifiers are bounded and reject invalid input", function()
        eq(W.reward(100, 1.25), 125, "bonus")
        eq(W.reward(11, 1.1), 12, "round down")
        eq(W.reward(-1, 1.1), 0, "negative")
        eq(W.reward(100, math.huge), 0, "infinite")
        eq(W.reward(math.huge, 1.1), 0, "bad base")
    end)
    test("weather rejects invalid timestamps", function()
        eq(W.phaseAt(-5).id, "calm", "negative")
        eq(W.phaseAt(0/0).id, "calm", "nan")
    end)
end
