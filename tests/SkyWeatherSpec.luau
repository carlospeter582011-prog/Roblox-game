return function(test, eq)
    local Weather = require("../src/shared/SkyWeather")
    test("sky weather rotates deterministically every five minutes", function()
        eq(Weather.phaseAt(0), "Clear", "initial")
        eq(Weather.phaseAt(299), "Clear", "before boundary")
        eq(Weather.phaseAt(300), "Drizzle", "rain")
        eq(Weather.phaseAt(600), "Gust", "wind")
        eq(Weather.phaseAt(900), "Storm", "storm")
        eq(Weather.phaseAt(1200), "Clear", "cycle")
        eq(Weather.phaseAt(-1), "Clear", "invalid")
    end)
    test("sky weather increases matching spawn weights without mutating catalog", function()
        local original = { a = { spawnWeight = 10, element = "Water" }, b = { spawnWeight = 4, element = "Air" } }
        local rain = Weather.adjustedCatalog(original, "Drizzle")
        eq(rain.a.spawnWeight, 20, "water boost")
        eq(rain.b.spawnWeight, 4, "air unchanged")
        eq(original.a.spawnWeight, 10, "original unchanged")
        eq(Weather.weightFor({ spawnWeight = math.huge, element = "Water" }, "Drizzle"), 0, "invalid weight")
        eq(Weather.weightFor({ spawnWeight = 2, element = "Electric" }, "Storm"), 4, "storm electric boost")
    end)
end
