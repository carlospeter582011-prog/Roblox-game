return function(test, eq)
    local P = require("../src/shared/IslandProductionRules")
    test("island production accrues full cycles only", function()
        local s, gained = P.accrue({kind="dew_collector",lastClaim=100,stored=0},20,281)
        eq(gained,4,"two cycles")
        eq(s.stored,4,"stored")
    end)
    test("island production rejects unearned stations and malformed timestamps", function()
        eq(P.accrue({kind="storm_condenser",lastClaim=0,stored=0},79,1000),nil,"locked")
        eq(P.accrue({kind="dew_collector",lastClaim=0,stored=0},20,math.huge),nil,"infinite")
        eq(P.accrue({kind="dew_collector",lastClaim=-1,stored=0},20,1000),nil,"negative")
    end)
    test("island production caps offline gain and station storage", function()
        local s = P.accrue({kind="dew_collector",lastClaim=100,stored=499},20,1e8)
        eq(s.stored,500,"storage cap")
        local x = P.accrue({kind="wind_turbine",lastClaim=100,stored=0},40,1e8)
        eq(x.stored,500,"offline cap and storage cap")
    end)
    test("island production clock rollback cannot mint resources", function()
        local s,gain = P.accrue({kind="dew_collector",lastClaim=500,stored=7},20,400)
        eq(gain,0,"no rollback reward")
        eq(s.stored,7,"unchanged")
    end)
    test("island claim is immutable and rejects overflow", function()
        local inventory = {sky_dew=8}
        local station = {kind="dew_collector",lastClaim=100,stored=2}
        local result = P.claim(station,20,190,inventory)
        eq(result.awarded,4,"two stored plus cycle")
        eq(result.inventory.sky_dew,12,"new inventory")
        eq(inventory.sky_dew,8,"original unchanged")
        eq(station.stored,2,"original station unchanged")
        eq(P.claim(station,20,190,{sky_dew=1e9}),nil,"overflow rejected")
    end)
end
