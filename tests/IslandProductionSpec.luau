return function(test, eq)
    local Rules = require("../src/shared/IslandProductionRules")
    local catalog = { breeze = { element = "Air" }, drizzle = { element = "Water" } }
    test("island habitats require owned elemental clouds and coins", function()
        eq(Rules.canBuild("breeze_nest", 100, 0, { breeze = 1 }, catalog), true, "valid")
        eq(Rules.canBuild("breeze_nest", 99, 0, { breeze = 1 }, catalog), false, "cost")
        eq(Rules.canBuild("breeze_nest", 100, 0, { drizzle = 2 }, catalog), false, "element")
        eq(Rules.canBuild("breeze_nest", 100, 12, { breeze = 1 }, catalog), false, "limit")
        eq(Rules.canBuild("unknown", 1000, 0, { breeze = 1 }, catalog), false, "unknown")
        eq(Rules.canBuild("breeze_nest", math.huge, 0, { breeze = 1 }, catalog), false, "infinite")
    end)
    test("island production preserves partial ticks and respects storage cap", function()
        local a = Rules.harvest("breeze_nest", 119, 0, 0)
        eq(a.generated, 0, "before tick")
        eq(a.carry, 119, "carry")
        local b = Rules.harvest("breeze_nest", 1, a.stored, a.carry)
        eq(b.generated, 3, "tick")
        eq(b.carry, 0, "reset")
        eq(Rules.harvest("breeze_nest", 600, 238, 0).stored, 240, "cap")
    end)
    test("island offline earnings cap at eight hours and reject corrupt values", function()
        local a = Rules.harvest("storm_turbine", 999999, 0, 0)
        eq(a.cappedOffline, true, "offline capped")
        eq(a.stored, 480, "storage capped")
        eq(Rules.harvest("storm_turbine", -1, 0, 0), nil, "negative")
        eq(Rules.harvest("storm_turbine", 100, 0, math.huge), nil, "infinite carry")
        eq(Rules.harvest("storm_turbine", 100, 0, 300), nil, "invalid carry")
    end)
    test("island claims credit stored production exactly once", function()
        local first = Rules.claim("breeze_nest", { lastAccrued = 1000, stored = 9, carry = 0 }, 1120, 20)
        eq(first.credited, 12, "stored plus new production")
        eq(first.coins, 32, "wallet")
        eq(first.job.stored, 0, "storage emptied")
        local second = Rules.claim("breeze_nest", first.job, 1120, first.coins)
        eq(second.credited, 0, "same timestamp cannot duplicate")
        eq(second.coins, 32, "unchanged wallet")
    end)
    test("island claim rejects clock rollback and overflow", function()
        eq(Rules.claim("breeze_nest", { lastAccrued = 100 }, 99, 0), nil, "rollback")
        eq(Rules.claim("breeze_nest", { lastAccrued = 0 }, 120, 9007199254740991), nil, "overflow")
    end)
end
