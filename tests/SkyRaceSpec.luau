return function(test, eq)
    local Rules = require("../src/shared/SkyRaceRules")
    test("sky race enforces sequential checkpoint gates", function()
        local s = { started = 100, next = 1 }
        eq(select(2, Rules.advance(s, 2, 111)), "order", "skip gate")
        s = Rules.advance(s, 1, 110)
        eq(s.next, 2, "first gate")
        s = Rules.advance(s, 2, 115)
        s = Rules.advance(s, 3, 120)
        local finished, reason = Rules.advance(s, 4, 130)
        eq(reason, "finished", "finished")
        eq(finished.elapsed, 30, "elapsed")
    end)
    test("sky race rejects impossible timing and invalid rewards", function()
        local s = { started = 100, next = 4 }
        eq(select(2, Rules.advance(s, 4, 105)), "too_fast", "speed exploit")
        eq(select(2, Rules.advance(s, 4, 201)), "expired", "timeout")
        eq(select(2, Rules.advance(s, 4, 90)), "expired", "backwards clock")
        eq(Rules.reward(1), nil, "no early payout")
        eq(Rules.reward(math.huge), nil, "no infinite payout")
        eq(select(1, Rules.reward(24)), 140, "gold coins")
        eq(select(1, Rules.reward(40)), 95, "silver coins")
        eq(select(1, Rules.reward(80)), 65, "bronze coins")
    end)
end
