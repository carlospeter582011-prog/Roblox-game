local Rules = require("../src/shared/SkyRaceRules")
local function check(value, expected)
    assert(value == expected, tostring(value) .. " ~= " .. tostring(expected))
end
local state, msg = Rules.advance(nil, 1, 2, 100)
check(msg, "Started")
check(state.next, 2)
local bad = Rules.advance(state, 3, 2, 105)
check(bad, nil)
bad = Rules.advance(state, 2, 16, 105)
check(bad, nil)
state = Rules.advance(state, 2, 2, 110)
check(state.next, 3)
state, msg = Rules.advance(state, 3, 2, 120)
check(msg, "Finished")
check(state.cooldownUntil, 300)
bad = Rules.advance(state, 1, 2, 121)
check(bad, nil)
local again = Rules.advance(state, 1, 2, 300)
check(again.next, 2)
local expired = Rules.advance(again, 2, 2, 391)
check(expired, nil)
check(Rules.advance(nil, 1, 0/0, 100), nil)
check(Rules.advance(nil, 1, math.huge, 100), nil)
print("SkyRaceRules: 12 assertions passed")
