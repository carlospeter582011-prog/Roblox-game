local Rules = require("../src/shared/SkyUpdraftRules")
return function(test, eq)
    test("updraft requires profile, alive character and nearby prompt", function()
        eq(Rules.canLaunch("meadow", 3, 0, 8, true, true), true, "valid")
        eq(Rules.canLaunch("meadow", 14, 0, 8, true, true), false, "far")
        eq(Rules.canLaunch("meadow", 3, 0, 8, false, true), false, "not ready")
        eq(Rules.canLaunch("meadow", 3, 0, 8, true, false), false, "dead")
    end)
    test("updraft unlock thresholds and cooldown enforce progression", function()
        eq(Rules.canLaunch("eastwind", 3, 19, 8, true, true), false, "locked")
        eq(Rules.canLaunch("eastwind", 3, 20, 8, true, true), true, "unlocked")
        eq(Rules.canLaunch("ridge", 3, 60, 7.99, true, true), false, "cooldown")
        eq(Rules.canLaunch("ridge", 3, 60, 8, true, true), true, "recharged")
    end)
    test("updraft rejects malformed numbers and unknown station", function()
        eq(Rules.canLaunch("fake", 3, 100, 8, true, true), false, "unknown")
        eq(Rules.canLaunch("meadow", 0/0, 100, 8, true, true), false, "nan distance")
        eq(Rules.canLaunch("meadow", 3, math.huge, 8, true, true), false, "inf captures")
        eq(Rules.canLaunch("meadow", 3, 100, -math.huge, true, true), false, "inf elapsed")
    end)
end
