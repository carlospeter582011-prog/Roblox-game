return function(test, eq)
    local Rules = require("../src/shared/SkyUpdraftRules")
    test("updraft validates distance, life and cooldown", function()
        eq(Rules.canLaunch(10, 100, nil, true), true, "initial launch")
        eq(Rules.canLaunch(16, 100, nil, true), false, "out of range")
        eq(Rules.canLaunch(5, 100, 95, true), false, "cooldown")
        eq(Rules.canLaunch(5, 103, 95, true), true, "cooldown complete")
        eq(Rules.canLaunch(5, 100, nil, false), false, "dead player")
        eq(Rules.canLaunch(0/0, 100, nil, true), false, "nan distance")
    end)
    test("updraft produces bounded normalized 3D impulse", function()
        local x, y, z = Rules.velocity(3, 4)
        eq(y, 72, "vertical impulse")
        assert(math.abs(x - 15.6) < 0.001 and math.abs(z - 20.8) < 0.001, "horizontal impulse")
        local dx, dy, dz = Rules.velocity(0, 0)
        eq(dx, 0, "zero direction x")
        eq(dy, 72, "zero direction vertical")
        eq(dz, 0, "zero direction z")
    end)
end
