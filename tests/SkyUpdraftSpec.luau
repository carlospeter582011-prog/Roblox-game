local Rules = require("../src/shared/SkyUpdraftRules")
return function(test, eq)
    test("updraft validates server distance and profile", function()
        eq(Rules.canLaunch(10, true, true, 20, nil), true, "valid")
        eq(Rules.canLaunch(15, true, true, 20, nil), false, "too far")
        eq(Rules.canLaunch(-1, true, true, 20, nil), false, "negative")
        eq(Rules.canLaunch(1, false, true, 20, nil), false, "dead")
        eq(Rules.canLaunch(1, true, false, 20, nil), false, "profile")
    end)
    test("updraft enforces cooldown and rejects NaN", function()
        eq(Rules.canLaunch(1, true, true, 20, 13), false, "cooldown")
        eq(Rules.canLaunch(1, true, true, 21, 13), true, "ready")
        eq(Rules.canLaunch(0/0, true, true, 21, nil), false, "NaN")
    end)
    test("updraft directions are bounded", function()
        local x, z = Rules.direction(3, 4)
        eq(math.floor(x*10+0.5), 6, "x")
        eq(math.floor(z*10+0.5), 8, "z")
    end)
end
