return function(test, eq)
local Rules = require("../src/shared/SkyUpdraftRules")
local function check(value, message)
    assert(value, message)
end
test("updraft progression and valid activation", function()
check(Rules.canActivate("meadow", 0, 10, true, true, 100, nil), "starter available")
check(not Rules.canActivate("ridge", 44, 10, true, true, 100, nil), "progression gate")
check(Rules.canActivate("ridge", 45, 10, true, true, 100, nil), "ridge unlock")
check(not Rules.canActivate("meadow", 100, 15, true, true, 100, nil), "distance gate")
check(not Rules.canActivate("meadow", 100, 10, false, true, 100, nil), "dead")
check(not Rules.canActivate("meadow", 100, 10, true, false, 100, nil), "unloaded")
end)
test("updraft cooldown and invalid input rejected", function()
check(not Rules.canActivate("meadow", 100, 10, true, true, 110, 100), "cooldown")
check(Rules.canActivate("meadow", 100, 10, true, true, 112, 100), "cooldown expires")
check(not Rules.canActivate("meadow", 100, 0/0, true, true, 112, nil), "nan distance")
check(not Rules.canActivate("meadow", 100, 10, true, true, 99, 100), "clock rollback")
end)
end
