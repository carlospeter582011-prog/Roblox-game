return function(test, eq)
    local Rules = require("../src/shared/SkyCompassRules")
    test("compass selects nearest cloud with deterministic ties", function()
        local id, distance = Rules.nearest({ b = 20, a = 20, c = 180, far = 181 })
        eq(id, "a", "tie")
        eq(distance, 20, "distance")
        eq(Rules.nearest({ far = 181, bad = math.huge, neg = -1 }), nil, "reject invalid")
    end)
    test("compass refuses malformed values and unavailable players", function()
        eq(Rules.canScan(100, nil, true, true), true, "first scan")
        eq(Rules.canScan(120, 100, true, true), false, "cooldown")
        eq(Rules.canScan(125, 100, true, true), true, "cooldown elapsed")
        eq(Rules.canScan(100, nil, false, true), false, "dead")
        eq(Rules.canScan(100, nil, true, false), false, "profile absent")
        eq(Rules.canScan(math.huge, nil, true, true), false, "invalid clock")
        eq(Rules.canScan(100, 0/0, true, true), false, "invalid prior scan")
    end)
end
