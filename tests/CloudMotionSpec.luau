return function(test, eq)
    local Motion = require("../src/shared/CloudMotionRules")
    test("cloud elements have distinct bounded movement", function()
        local ax, ay, az = Motion.offset("Air", 10, 1)
        local ix, iy, iz = Motion.offset("Ice", 10, 1)
        eq(ax ~= ix or az ~= iz, true, "different elements")
        eq(ax * ax + az * az <= 25.0001, true, "air bound")
        eq(ix * ix + iz * iz <= 3.2401, true, "ice bound")
        eq(math.abs(ay) <= 0.8, true, "air lift bound")
        eq(math.abs(iy) <= 0.4, true, "ice lift bound")
    end)
    test("cloud motion is deterministic and sanitizes nonfinite time", function()
        local a,b,c = Motion.offset("Storm", 4, 9)
        local x,y,z = Motion.offset("Storm", 4, 9)
        eq(a, x, "x repeat")
        eq(b, y, "y repeat")
        eq(c, z, "z repeat")
        local q = Motion.offset("Storm", 0/0, math.huge)
        eq(type(q), "number", "nonfinite guarded")
    end)
end
