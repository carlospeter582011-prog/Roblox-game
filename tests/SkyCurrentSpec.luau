return function(test, eq)
    local Rules = require("../src/shared/SkyCurrentRules")
    test("sky current requires ordered 3D valve sequence", function()
        local step, complete = Rules.advance(0, "north", 1)
        eq(step, 1, "north")
        eq(complete, false, "not complete")
        step = Rules.advance(step, "east", 3)
        eq(step, 2, "east")
        step, complete = Rules.advance(step, "west", 5)
        eq(step, 3, "west")
        eq(complete, true, "complete")
        eq(Rules.advance(1, "west", 2), 0, "wrong resets")
    end)
    test("sky current rejects expired and malformed attempts", function()
        eq(Rules.advance(0, "north", 71), 0, "expired")
        eq(Rules.advance(0, "north", 0/0), 0, "nan")
        eq(Rules.advance(-1, "north", 1), 0, "bad step")
        eq(Rules.eligible(10, true, 100, 200, 0), true, "eligible")
        eq(Rules.eligible(15, true, 100, 200, 0), false, "far")
        eq(Rules.eligible(10, true, 100, 200, 100), false, "cooldown")
        eq(Rules.eligible(10, false, 100, 200, 0), false, "unready")
    end)
end
