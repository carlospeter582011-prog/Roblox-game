local Rules = require("../src/shared/WeatherHarmonizerRules")
return function(test, eq)
    test("harmonizer rejects remote and invalid prompt positions", function()
        eq(Rules.canActivate(12, true, true), true, "near valid")
        eq(Rules.canActivate(17, true, true), false, "too far")
        eq(Rules.canActivate(0/0, true, true), false, "nan")
        eq(Rules.canActivate(1, false, true), false, "dead")
        eq(Rules.canActivate(1, true, false), false, "unloaded")
    end)
    test("harmonizer needs two distinct players within time window", function()
        eq(Rules.complete({userId=1,at=10},{userId=2,at=20},20), true, "two players")
        eq(Rules.complete({userId=1,at=10},{userId=1,at=20},20), false, "same player")
        eq(Rules.complete({userId=1,at=1},{userId=2,at=20},20), false, "expired")
        eq(Rules.complete({userId=1,at=30},{userId=2,at=20},20), false, "future")
    end)
    test("harmonizer cooldown is bounded and rejects invalid clocks", function()
        eq(Rules.cooldownReady(nil, 100), true, "first")
        eq(Rules.cooldownReady(100, 174), false, "cooling")
        eq(Rules.cooldownReady(100, 175), true, "ready")
        eq(Rules.cooldownReady(100, math.huge), false, "infinite")
    end)
end
