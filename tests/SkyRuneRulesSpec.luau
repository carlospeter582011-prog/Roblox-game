local Rules = require("../src/shared/SkyRuneRules")
local function eq(a,b) assert(a == b, tostring(a) .. " ~= " .. tostring(b)) end
local s,t,done = Rules.advance(0,nil,"Air",100,5,true)
eq(s,1) eq(t,100) eq(done,false)
s,t,done = Rules.advance(s,t,"Water",110,5,true)
eq(s,2) eq(done,false)
s,t,done = Rules.advance(s,t,"Storm",120,5,true)
eq(s,0) eq(done,true)
eq(select(1,Rules.advance(0,nil,"Storm",100,5,true)),0)
eq(select(1,Rules.advance(1,100,"Water",176,5,true)),0)
eq(select(1,Rules.advance(0,nil,"Air",100,14,true)),0)
eq(select(1,Rules.advance(0,nil,"Air",100,5,false)),0)
eq(select(1,Rules.advance(0,nil,"Air",math.huge,5,true)),0)
print("SkyRuneRulesSpec passed")
