return function(test, eq)
    local Rules = require("../src/shared/SkyRuneRules")
    test("rune sequence opens cooperative bridge only after correct order", function()
        local s,t,done = Rules.advance(0,nil,"Air",100,5,true)
        eq(s,1,"air stage") eq(t,100,"start") eq(done,false,"not complete")
        s,t,done = Rules.advance(s,t,"Water",110,5,true)
        eq(s,2,"water stage") eq(done,false,"still locked")
        s,t,done = Rules.advance(s,t,"Storm",120,5,true)
        eq(s,0,"reset") eq(done,true,"bridge opens")
    end)
    test("rune sequence rejects wrong order, expired timer and bad range", function()
        eq(select(1,Rules.advance(0,nil,"Storm",100,5,true)),0,"wrong order")
        eq(select(1,Rules.advance(1,100,"Water",176,5,true)),0,"expired")
        eq(select(1,Rules.advance(0,nil,"Air",100,14,true)),0,"out of range")
        eq(select(1,Rules.advance(0,nil,"Air",100,5,false)),0,"not ready")
        eq(select(1,Rules.advance(0,nil,"Air",math.huge,5,true)),0,"invalid time")
        eq(select(1,Rules.advance(0,nil,"Air",100,0/0,true)),0,"nan distance")
    end)
end
