return function(test, eq)
    local Rules = require("../src/shared/SkyLanternRules")
    test("lanterns require correct order and server-side proximity", function()
        eq(Rules.canActivate(1, 10, 100, nil, 1, 0), true)
        eq(Rules.canActivate(2, 10, 110, 100, 2, 0), true)
        eq(Rules.canActivate(3, 10, 146, 100, 3, 0), false)
        eq(Rules.canActivate(2, 15, 110, 100, 2, 0), false)
        eq(Rules.canActivate(2, 10, 110, 100, 1, 0), false)
        eq(Rules.canActivate(1, 10, 110, nil, 1, 150), false)
    end)
    test("lanterns reject malformed inputs and solo completion", function()
        eq(Rules.canActivate(1, 0/0, 100, nil, 1, 0), false)
        eq(Rules.canActivate(1, 10, math.huge, nil, 1, 0), false)
        eq(Rules.canActivate(1.5, 10, 100, nil, 1, 0), false)
        eq(Rules.canComplete(1), false)
        eq(Rules.canComplete(2), true)
        eq(Rules.canComplete(math.huge), false)
    end)
end
