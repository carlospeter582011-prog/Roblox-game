return function(test, eq)
    local Rules = require("../src/shared/StormShelterRules")
    test("storm join requires live profile and proximity", function()
        eq(Rules.canJoin(true, true, 8, 100, nil), true, "join")
        eq(Rules.canJoin(false, true, 8, 100, nil), false, "profile")
        eq(Rules.canJoin(true, false, 8, 100, nil), false, "alive")
        eq(Rules.canJoin(true, true, 13, 100, nil), false, "range")
        eq(Rules.canJoin(true, true, math.huge, 100, nil), false, "infinite")
        eq(Rules.canJoin(true, true, 8, 100, 90), false, "cooldown")
        eq(Rules.canJoin(true, true, 8, 190, 100), true, "cooldown elapsed")
    end)
    test("storm reward requires all waves and safe wallet", function()
        eq(Rules.canReward({ coins = 20, xp = 30 }, 3, false), true, "earned")
        eq(Rules.canReward({ coins = 20, xp = 30 }, 2, false), false, "incomplete")
        eq(Rules.canReward({ coins = 20, xp = 30 }, 3, true), false, "paid")
        eq(Rules.canReward({ coins = 1000000000, xp = 0 }, 3, false), false, "cap")
        eq(Rules.canReward({ coins = 0, xp = math.huge }, 3, false), false, "invalid xp")
    end)
end
