local Rules = require("../src/shared/StormShelterRules")
local function eq(a,b) assert(a == b, tostring(a) .. " ~= " .. tostring(b)) end
local ok, reason, state = Rules.activate(nil, 1, 10)
eq(ok,true) eq(reason,"progress")
ok,reason,state = Rules.activate(state,1,11)
eq(ok,false) eq(reason,"duplicate")
ok,reason,state = Rules.activate(state,2,12)
eq(ok,true)
ok,reason,state = Rules.activate(state,3,13)
eq(ok,true) eq(reason,"complete")
ok,reason,state = Rules.activate(state,1,14)
eq(ok,false) eq(reason,"cooldown")
ok,reason,state = Rules.activate(state,1,104)
eq(ok,true) eq(reason,"progress")
ok,reason,state = Rules.activate(state,2,130)
eq(ok,true) eq(reason,"progress")
eq(state.used[1],nil)
ok,reason = Rules.activate(state,4,131)
eq(ok,false) eq(reason,"invalid")
print("StormShelterRules: 8 assertions passed")
