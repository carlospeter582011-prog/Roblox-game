return function(test, eq)
    local Rules = require("../src/shared/StormShelterRules")
    test("storm shelter boundary and malformed coordinates", function()
        eq(Rules.inShelter(14, 0, 0, 0, 14), true, "edge")
        eq(Rules.inShelter(14.1, 0, 0, 0, 14), false, "outside")
        eq(Rules.inShelter(0, 0, 0, 0, -1), false, "negative radius")
        eq(Rules.inShelter(0/0, 0, 0, 0, 14), false, "nan")
    end)
    test("storm participation requires 22 safe samples", function()
        local n = 0
        for _ = 1, 21 do n = Rules.advance(n, true, true) end
        eq(n, 21, "progress")
        local nextN, won = Rules.advance(n, true, true)
        eq(nextN, 22, "threshold")
        eq(won, true, "reward eligible")
    end)
    test("unsafe and unready players cannot advance", function()
        local n, won = Rules.advance(20, false, true)
        eq(n, 20, "unsafe")
        eq(won, false, "not won")
        n = Rules.advance(n, true, false)
        eq(n, 20, "not ready")
        eq(Rules.advance(999, true, true), 22, "cap")
    end)
end
