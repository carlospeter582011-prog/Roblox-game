return function(test, eq)
local Rules = require("../src/shared/StormShelterRules")
test("storm shelter requires three distinct signals and cooldown", function()
    local ok, reason, state = Rules.activate(nil, 1, 10)
    eq(ok, true, "first")
    eq(reason, "progress", "progress")
    ok, reason, state = Rules.activate(state, 1, 11)
    eq(ok, false, "duplicate rejected")
    eq(reason, "duplicate", "reason")
    ok, reason, state = Rules.activate(state, 2, 12)
    eq(ok, true, "second")
    ok, reason, state = Rules.activate(state, 3, 13)
    eq(ok, true, "third")
    eq(reason, "complete", "complete")
    ok, reason, state = Rules.activate(state, 1, 14)
    eq(ok, false, "cooldown")
    eq(reason, "cooldown", "cooldown reason")
    ok, reason, state = Rules.activate(state, 1, 104)
    eq(ok, true, "restarted")
end)
test("storm shelter expires progress and rejects invalid signals", function()
    local _, _, state = Rules.activate(nil, 1, 1)
    local ok, reason
    ok, reason, state = Rules.activate(state, 2, 27)
    eq(ok, true, "new window")
    eq(state.used[1], nil, "expired signal cleared")
    ok, reason = Rules.activate(state, 4, 28)
    eq(ok, false, "invalid switch")
    eq(reason, "invalid", "invalid reason")
    ok = Rules.activate(state, 3, math.huge)
    eq(ok, false, "infinite time")
end)
end
