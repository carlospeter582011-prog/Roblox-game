return function(test, eq)
    local Rules = require("../src/shared/SkySalvageRules")
    test("salvage progression and rewards are server-bounded", function()
        local ok, reward = Rules.canClaim("breeze", 0, 5, 100, nil, 0)
        eq(ok, true, "starter claim")
        eq(reward.coins, 22, "starter coins")
        eq(Rules.canClaim("storm", 14, 5, 100, nil, 0), false, "locked tier")
        eq(Rules.canClaim("storm", 15, 5, 100, nil, 0), true, "unlocked tier")
        eq(Rules.canClaim("cosmic", 50, 5, 100, nil, 0), true, "final tier")
    end)
    test("salvage denies replay, distance and malformed requests", function()
        eq(Rules.canClaim("breeze", 50, 5, 100, 80, 0), false, "cooldown")
        eq(Rules.canClaim("breeze", 50, 5, 155, 80, 0), true, "cooldown elapsed")
        eq(Rules.canClaim("breeze", 50, 15, 100, nil, 0), false, "too far")
        eq(Rules.canClaim("breeze", 50, 5, 100, nil, 12), false, "session limit")
        eq(Rules.canClaim("bogus", 50, 5, 100, nil, 0), false, "unknown")
        eq(Rules.canClaim("breeze", 50, 0/0, 100, nil, 0), false, "nan distance")
    end)
end
