-- Regression tests for EvolutionRules\nreturn function(test, eq)\n    local Rules = require(\"../src/shared/EvolutionRules\")\n    local catalog = {\n        breeze = { name = \"Breeze\" }, gale = { name = \"Gale\" },\n        drizzle = { name = \"Drizzle\" }, monsoon = { name = \"Monsoon\" },\n    }\n    test(\"evolution requires threshold and valid target\", function()\n        eq(Rules.canEvolve(\"breeze\", 14, catalog), false, \"below threshold\")\n        eq(Rules.canEvolve(\"breeze\", 15, catalog), true, \"meets threshold\")\n        eq(Rules.canEvolve(\"unknown\", 20, catalog), false, \"no path\")\n    end)\n    test(\"evolve consumes one base and grants evolved\", function()\n        local counts = { breeze = 15, gale = 0 }\n        local next, did = Rules.evolve(\"breeze\", counts, catalog)\n        eq(did, true, \"evolved\")\n        eq(next.breeze, 14, \"base reduced\")\n        eq(next.gale, 1, \"evolved granted\")\n        eq(counts.breeze, 15, \"original unchanged\")\n    end)\n    test(\"evolve refuses insufficient count\", function()\n        local counts = { breeze = 10 }\n        local next, did = Rules.evolve(\"breeze\", counts, catalog)\n        eq(did, false, \"refused\")\n        eq(next, counts, \"same table\")\n    end)\nend\n