-- Regression tests for EvolutionRules. Pure Luau, no Roblox.
local Rules = require("../src/shared/EvolutionRules")

return function(test, eq)
	test("evolution stage starts at 0 and advances at thresholds", function()
		eq(Rules.stageForXp(0), 0, "zero")
		eq(Rules.stageForXp(24), 0, "below first")
		eq(Rules.stageForXp(25), 1, "first threshold")
		eq(Rules.stageForXp(79), 1, "below second")
		eq(Rules.stageForXp(80), 2, "second")
		eq(Rules.stageForXp(200), 3, "third")
		eq(Rules.stageForXp(500), 4, "max")
		eq(Rules.stageForXp(10000), 4, "over max stays")
	end)

	test("invalid XP values are treated as stage 0", function()
		eq(Rules.stageForXp(-1), 0, "negative")
		eq(Rules.stageForXp(0/0), 0, "nan")
		eq(Rules.stageForXp(math.huge), 0, "inf")
		eq(Rules.stageForXp("bad"), 0, "non number")
	end)

	test("xp to next and canEvolve are consistent", function()
		eq(Rules.xpToNext(0), 25, "from zero")
		eq(Rules.xpToNext(10), 15, "partial")
		eq(Rules.xpToNext(25), 55, "at stage 1")
		eq(Rules.xpToNext(500), nil, "max has no next")
		eq(Rules.canEvolve(0), true, "can")
		eq(Rules.canEvolve(500), false, "cannot")
	end)

	test("awardXp bounds and rejects bad amounts", function()
		eq(Rules.awardXp(10, 5), 15, "normal")
		eq(Rules.awardXp(10, -5), 10, "negative ignored")
		eq(Rules.awardXp(10, 0), 10, "zero ignored")
		eq(Rules.awardXp(10, math.huge), 10, "inf ignored")
		eq(Rules.awardXp(-5, 10), 10, "bad current reset then award")
		eq(Rules.awardXp(9990, 20, 10000), 10000, "cap respected")
	end)

	test("stage names match stages", function()
		eq(Rules.stageName(0), "Spark", "base")
		eq(Rules.stageName(1), "Whisper", "one")
		eq(Rules.stageName(4), "Ascendant", "max")
		eq(Rules.stageName(99), "Spark", "out of range")
	end)
end
