local Rules = require("../src/shared/CrystalRules")
return function(test, eq)
    test("crystal discovery accepts eligible nearby player", function()
        eq(Rules.canDiscover(1, 10, false, true), true, "nearby")
        eq(Rules.canDiscover(18, 13, false, true), true, "boundary")
    end)
    test("crystal discovery rejects invalid or distant requests", function()
        for _, distance in ipairs({ -1, 13.01, math.huge, 0/0 }) do
            eq(Rules.canDiscover(1, distance, false, true), false, "distance")
        end
        eq(Rules.canDiscover(0, 1, false, true), false, "index zero")
        eq(Rules.canDiscover(19, 1, false, true), false, "index over limit")
        eq(Rules.canDiscover(1.5, 1, false, true), false, "fractional index")
    end)
    test("crystal discovery requires ready profile and rejects duplicates", function()
        eq(Rules.canDiscover(1, 1, true, true), false, "duplicate")
        eq(Rules.canDiscover(1, 1, false, false), false, "not ready")
    end)
    test("first crystal discovery gives fixed non-random rewards", function()
        local coins, xp = Rules.reward(1, false)
        eq(coins, 10, "coins")
        eq(xp, 5, "xp")
    end)
    test("repeat or invalid discovery never grants rewards", function()
        for _, index in ipairs({ 0, 19, 1.5 }) do
            local coins, xp = Rules.reward(index, false)
            eq(coins, 0, "invalid coins")
            eq(xp, 0, "invalid xp")
        end
        local coins, xp = Rules.reward(1, true)
        eq(coins, 0, "duplicate coins")
        eq(xp, 0, "duplicate xp")
    end)
    test("crystal count ignores corrupt and out-of-range entries", function()
        eq(Rules.count({ [1]=true, [2]=true, [19]=true, [3]=false, bogus=true }), 2, "count")
    end)
    test("constellation milestones award only at 6, 12 and 18 unique crystals", function()
        for _, milestone in ipairs({ {6,150,75}, {12,400,200}, {18,900,450} }) do
            local coins, xp, reached = Rules.constellationReward(milestone[1]-1, milestone[1])
            eq(coins, milestone[2], "coins")
            eq(xp, milestone[3], "xp")
            eq(reached, milestone[1], "milestone")
        end
        local coins, xp = Rules.constellationReward(6, 7)
        eq(coins, 0, "non-milestone coins")
        eq(xp, 0, "non-milestone xp")
    end)
    test("constellation cannot pay twice or accept invalid counts", function()
        for _, pair in ipairs({ {6,6}, {5,7}, {-1,6}, {17,19}, {0/0,6}, {math.huge,6}, {5,5.5} }) do
            local coins, xp, milestone = Rules.constellationReward(pair[1], pair[2])
            eq(coins, 0, "invalid coins")
            eq(xp, 0, "invalid xp")
            eq(milestone, nil, "invalid milestone")
        end
    end)
end
