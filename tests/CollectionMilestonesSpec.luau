local Milestones = require("../src/shared/CollectionMilestones")
return function(test, eq)
    test("unique collection counts catalogued base species, not mutations or invalid values", function()
        local catalog = { breeze = {}, drizzle = {}, cirrus = {} }
        eq(Milestones.uniqueCount({ breeze = 2, drizzle = 1, ["breeze:golden"] = 9, fake = 99 }, catalog), 2, "two unique")
        eq(Milestones.uniqueCount({ breeze = math.huge, drizzle = 0, cirrus = 0/0 }, catalog), 0, "reject invalid")
        eq(Milestones.uniqueCount(nil, catalog), 0, "missing profile")
    end)
    test("milestones pay only when newly crossing a threshold", function()
        local coins, xp, milestone = Milestones.crossed(4, 5)
        eq(coins, 100, "first coins")
        eq(xp, 50, "first xp")
        eq(milestone, 5, "first threshold")
        eq(select(1, Milestones.crossed(5, 5)), 0, "duplicate catch pays nothing")
        eq(select(1, Milestones.crossed(5, 6)), 0, "no repeated grant")
        eq(select(1, Milestones.crossed(15, 14)), 0, "no grant on decreasing")
        eq(select(1, Milestones.crossed(0/0, 100)), 0, "invalid previous")
        eq(select(1, Milestones.crossed(0, math.huge)), 0, "invalid current")
    end)
    test("multiple milestones crossing are summed without skipping rewards", function()
        local coins, xp, highest = Milestones.crossed(4, 30)
        eq(coins, 1050, "5 + 15 + 30 coins")
        eq(xp, 420, "5 + 15 + 30 xp")
        eq(highest, 30, "highest")
    end)
end
