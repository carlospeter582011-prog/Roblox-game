-- Pure regression tests for the ordered, timed Sky Ring Sprint.
local R = require("../src/shared/SkyRingRules")
local function eq(a,b) assert(a == b, tostring(a) .. " ~= " .. tostring(b)) end
local s,status = R.advance(nil,1,100)
eq(status,"started")
eq(s.next,2)
eq(select(2,R.advance(s,3,101)),"wrong_order")
s,status = R.advance(s,2,105)
eq(status,"advanced")
s = select(1,R.advance(s,3,110))
s = select(1,R.advance(s,4,115))
local elapsed
s,status,elapsed = R.advance(s,5,120)
eq(status,"completed")
eq(elapsed,20)
eq(s.best,20)
eq(select(2,R.advance(s,1,122)),"cooldown")
s = select(1,R.advance(s,1,130))
eq(s.best,20)
eq(select(2,R.advance(s,2,221)),"expired")
eq(select(2,R.advance(nil,2,10)),"wrong_order")
eq(select(2,R.advance(nil,6,10)),"invalid_checkpoint")
eq(select(2,R.advance(nil,1,0/0)),"invalid_time")
print("SkyRingRulesSpec passed")
