local R = require("../src/shared/SkyRingRules")
return function(test, eq)
    test("sky ring sprint validates order, timing and personal best", function()
        local s, status = R.advance(nil, 1, 100)
        eq(status, "started", "start")
        eq(s.next, 2, "next checkpoint")
        eq(select(2, R.advance(s, 3, 101)), "wrong_order", "skip blocked")
        s = select(1, R.advance(s, 2, 105))
        s = select(1, R.advance(s, 3, 110))
        s = select(1, R.advance(s, 4, 115))
        local elapsed
        s, status, elapsed = R.advance(s, 5, 120)
        eq(status, "completed", "finish")
        eq(elapsed, 20, "elapsed")
        eq(s.best, 20, "best")
        eq(select(2, R.advance(s, 1, 122)), "cooldown", "cooldown")
        s = select(1, R.advance(s, 1, 130))
        eq(s.best, 20, "best retained")
        eq(select(2, R.advance(s, 2, 221)), "expired", "timeout")
    end)
    test("sky ring sprint rejects malformed input and wrong starts", function()
        eq(select(2, R.advance(nil, 2, 10)), "wrong_order", "not started")
        eq(select(2, R.advance(nil, 6, 10)), "invalid_checkpoint", "bad index")
        eq(select(2, R.advance(nil, 1, 0/0)), "invalid_time", "NaN")
        eq(select(2, R.advance(nil, 1, math.huge)), "invalid_time", "infinite")
    end)
end
